		type hadoop_log_t, hadoop_var_lib_t, hadoop_runtime_t;
		type hadoop_exec_t, hadoop_hsperfdata_t;
	')

	########################################
	#
	# Declarations
	#

	type hadoop_$1_t, hadoop_domain;
