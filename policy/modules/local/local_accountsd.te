policy_module(local_accountsd)

gen_require(`
	type accountsd_t;
	type xdg_cache_t;
')

# accounts-daemon resolves display-manager.service via readlink during login
# manager discovery.  Grant only generic systemd unit symlink reads here.
init_read_generic_units_symlinks(accountsd_t)

# It also probes per-user XDG cache directories while collecting optional user
# metadata.  Suppress harmless search noise for caches we do not want it to
# traverse, such as root's cache tree.
dontaudit accountsd_t xdg_cache_t:dir search;
