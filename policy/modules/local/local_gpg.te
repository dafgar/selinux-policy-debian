policy_module(local_gpg)

gen_require(`
	type gpg_agent_t;
	type security_t, selinux_config_t;
')

# gpg-agent launches scdaemon from /usr/lib/gnupg, which is labeled gpg_exec_t
# in the base policy. Reuse the shared gpg executable access pattern so smartcard
# support works for all SELinux user roles that enter gpg_agent_t.
gpg_exec(gpg_agent_t)

# pinentry-gnome3 is started from gpg-agent on this desktop stack and talks to
# the user session bus in the agent domain.
dbus_all_session_bus_client(gpg_agent_t)
dbus_write_session_runtime_socket(gpg_agent_t)

# pinentry checks for the presence of /etc/selinux during startup. Allow the
# narrow directory search that may affect control flow.
allow gpg_agent_t selinux_config_t:dir search;

# Generic helper interfaces for local GnuPG runtime adjustments shared by
# multiple SELinux users and their session managers.
