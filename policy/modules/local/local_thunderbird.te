policy_module(local_thunderbird)

gen_require(`
	type boot_t;
	type chromium_t;
	type etc_t;
	type evince_t;
	type fusefs_t;
	type mplayer_exec_t;
	type random_device_t;
	type systemd_logind_t;
	type sysctl_fs_t;
	type thunderbird_tmp_t;
	type thunderbird_tmpfs_t;
	type thunderbird_xdg_cache_t;
	type urandom_device_t;
	type user_runtime_t;
	type usr_t;
	type thunderbird_t;
	type user_home_dir_t;
	type var_lib_t;
	type virt_var_lib_t;
	type xdg_config_t;
	type xdg_data_t;
	class dbus send_msg;
')

corecmd_exec_bin(thunderbird_t)
corecmd_search_bin(thunderbird_t)

dbus_write_session_runtime_socket(thunderbird_t)

pulseaudio_client_domain(thunderbird_t)
corenet_udp_bind_generic_node(thunderbird_t)

pcscd_read_runtime_files(thunderbird_t)
pcscd_stream_connect(thunderbird_t)
logging_search_logs(thunderbird_t)
local_userdomain_dontaudit_generic_home_when_disabled(`thunderbird_read_generic_user_content', thunderbird_t)

xdg_search_config_dirs(thunderbird_t)
xdg_read_config_files(thunderbird_t)
fs_search_cgroup_dirs(thunderbird_t)
fs_getattr_cgroup_files(thunderbird_t)
fs_read_cgroup_files(thunderbird_t)
allow thunderbird_t thunderbird_xdg_cache_t:file map;
dontaudit thunderbird_t xdg_cache_t:file { read write };
dontaudit thunderbird_t xdg_cache_t:file { getattr lock open };
dontaudit thunderbird_t { etc_t usr_t var_lib_t xdg_config_t xdg_data_t }:dir watch;
dontaudit thunderbird_t mplayer_exec_t:file { execute getattr };
dontaudit thunderbird_t thunderbird_tmp_t:file map;
dontaudit thunderbird_t thunderbird_tmpfs_t:file execute;
dontaudit thunderbird_t sysctl_fs_t:dir search;
dontaudit thunderbird_t boot_t:dir search;
dontaudit thunderbird_t fusefs_t:dir write;
dontaudit thunderbird_t random_device_t:chr_file getattr;
dontaudit thunderbird_t virt_var_lib_t:dir search;
dontaudit thunderbird_t urandom_device_t:chr_file write;
dontaudit thunderbird_t user_home_dir_t:file { open read write };
dontaudit thunderbird_t user_runtime_t:file { open read write };
dontaudit systemd_logind_t thunderbird_t:dbus send_msg;

gnome_mmap_read_xdg_config_files(thunderbird_t)
gnome_watch_xdg_config_dirs(thunderbird_t)

userdom_search_user_runtime(thunderbird_t)
userdom_map_user_tmp_files(thunderbird_t)
allow thunderbird_t user_runtime_t:dir { add_name write };
allow thunderbird_t user_runtime_t:sock_file { create unlink write };

xserver_read_xkb_libs(thunderbird_t)
xserver_rw_mesa_shader_cache(thunderbird_t)
dev_rw_dri(thunderbird_t)
dev_read_sysfs(thunderbird_t)
wm_map_tmpfs_files(thunderbird_t)

ntp_dbus_chat(thunderbird_t)
systemd_dbus_chat_logind(thunderbird_t)

# Wayland clipboard transfers can pass an inherited pipe fd from Chromium to
# Thunderbird when pasting between confined desktop applications.
local_clipboard_pipe_write(chromium_t, thunderbird_t)
local_clipboard_pipe_write(evince_t, thunderbird_t)
local_evince_domtrans(thunderbird_t)

allow thunderbird_t self:cap_userns { sys_admin sys_chroot sys_ptrace };
allow thunderbird_t self:process { ptrace setcap setrlimit };
allow thunderbird_t self:user_namespace create;
