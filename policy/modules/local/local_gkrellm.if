## <summary>
##	Local GKrellM domain interfaces.
## </summary>

########################################
## <summary>
##	Allow a role to transition into the GKrellM application domain.
## </summary>
## <param name="source_domain">
##	<summary>
##	Domain allowed to execute and transition to GKrellM.
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access to the GKrellM domain.
##	</summary>
## </param>
#
interface(`gkrellm_role',`
	gen_require(`
		type gkrellm_t, gkrellm_exec_t;
		role $2;
	')

	role $2 types gkrellm_t;
	domtrans_pattern($1, gkrellm_exec_t, gkrellm_t)

	allow $1 gkrellm_t:process { ptrace signal_perms };
	allow $1 gkrellm_t:fd use;
	ps_process_pattern($1, gkrellm_t)

	allow gkrellm_t $1:process sigchld;
')

########################################
## <summary>
##	Allow GKrellM to connect to a peer's Unix stream socket, e.g. for
##	Wayland/X11 desktop integration.
## </summary>
## <param name="domain">
##	<summary>
##	Domain owning the stream socket.
##	</summary>
## </param>
#
interface(`local_gkrellm_stream_connect',`
	gen_require(`
		type gkrellm_t;
	')

	allow gkrellm_t $1:unix_stream_socket connectto;
')

########################################
## <summary>
##	Allow a domain to read/write GKrellM's MIT-SHM segment, e.g. the
##	compositor rendering GKrellM's window.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`local_gkrellm_shm',`
	gen_require(`
		type gkrellm_t;
	')

	allow $1 gkrellm_t:shm rw_shm_perms;
')

########################################
## <summary>
## Allow a user systemd instance to launch GKrellM with the usual
## inherited-exec process bits.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the user systemd domain.
##	</summary>
## </param>
#
interface(`local_gkrellm_systemd_inherit',`
	gen_require(`
		type gkrellm_t;
	')

	local_systemd_inherit_user_service($1, gkrellm_t)
	allow gkrellm_t $1_systemd_t:unix_stream_socket { getattr ioctl };
')

########################################
## <summary>
##	Allow GKrellM to connect to a role's session X11 socket, e.g. for its
##	legacy Xlib rendering path.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the session's X11 socket.
##	</summary>
## </param>
#
interface(`local_gkrellm_x11_connect',`
	gen_require(`
		type gkrellm_t;
	')

	local_$1_x11_connect(gkrellm_t)
')
