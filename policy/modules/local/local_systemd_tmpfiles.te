policy_module(local_systemd_tmpfiles)

gen_require(`
	type bin_t;
	type cron_spool_t;
	type security_t;
	type ssh_home_t;
	type systemd_networkd_var_lib_t;
	type systemd_tmpfiles_t;
	type uuidd_var_lib_t;
	type user_home_dir_t;
	type user_runtime_t;
	type user_tmp_t;
')

# Early boot tmpfiles processing traverses a small set of configuration and
# pseudo-filesystem paths that are not covered by the base policy on this
# system.  Keep the fix narrow to the observed accesses:
# - symlink metadata reads below bin_t-backed paths such as /etc/profile.d
# - directory search on cron spool paths
# - symlink metadata reads in securityfs such as /sys/kernel/security/ima
# - relabel operations from tmpfiles rules managing cron spool, provisioned
#   root home directories, uuid/network state dirs, and the shell-extra
#   symlink in /etc/profile.d
# - metadata updates from tpm2-tss-fapi tmpfiles z- rules for measurement
#   exports in securityfs; revisit if we later want a more path-specific model
# - directory metadata updates on a user_tmp_t path observed as "d3"; keep
#   this limited to setattr until the underlying tmpfiles rule/path is known

corecmd_search_bin(systemd_tmpfiles_t)
allow systemd_tmpfiles_t bin_t:lnk_file read_lnk_file_perms;
allow systemd_tmpfiles_t bin_t:lnk_file relabel_lnk_file_perms;

cron_search_spool(systemd_tmpfiles_t)
allow systemd_tmpfiles_t cron_spool_t:dir relabel_dir_perms;
allow systemd_tmpfiles_t systemd_networkd_var_lib_t:dir relabel_dir_perms;
allow systemd_tmpfiles_t uuidd_var_lib_t:dir relabel_dir_perms;

allow systemd_tmpfiles_t security_t:lnk_file read_lnk_file_perms;
allow systemd_tmpfiles_t security_t:file setattr_file_perms;
allow systemd_tmpfiles_t security_t:lnk_file setattr_lnk_file_perms;

allow systemd_tmpfiles_t user_home_dir_t:dir relabel_dir_perms;
allow systemd_tmpfiles_t user_runtime_t:dir manage_dir_perms;
allow systemd_tmpfiles_t user_runtime_t:file manage_file_perms;
allow systemd_tmpfiles_t ssh_home_t:dir relabel_dir_perms;
allow systemd_tmpfiles_t user_tmp_t:dir setattr_dir_perms;
auditallow systemd_tmpfiles_t user_tmp_t:dir setattr_dir_perms;
