HOME_DIR/\.cache/zotero(/.*)?	gen_context(system_u:object_r:zotero_xdg_cache_t,s0)
/tmp/zotero(/.*)?			gen_context(system_u:object_r:zotero_tmp_t,s0)
/tmp/MozillaUpdateLock-[^/]*	--	gen_context(system_u:object_r:zotero_tmp_t,s0)
