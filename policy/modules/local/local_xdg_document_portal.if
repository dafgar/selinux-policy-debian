## <summary>
##	Local XDG document portal domain interfaces.
## </summary>

########################################
## <summary>
##	Allow a role to transition into the XDG document portal application
##	domain.
## </summary>
## <param name="source_domain">
##	<summary>
##	Domain allowed to execute and transition to the XDG document portal.
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access to the XDG document portal domain.
##	</summary>
## </param>
#
interface(`xdg_document_portal_role',`
	gen_require(`
		type xdg_document_portal_t, xdg_document_portal_exec_t;
		role $2;
	')

	role $2 types xdg_document_portal_t;
	domtrans_pattern($1, xdg_document_portal_exec_t, xdg_document_portal_t)

	allow $1 xdg_document_portal_t:process { ptrace signal_perms };
	allow $1 xdg_document_portal_t:fd use;
	ps_process_pattern($1, xdg_document_portal_t)

	allow xdg_document_portal_t $1:process sigchld;
')

########################################
## <summary>
##	Wire up all of a role extra XDG document portal grants beyond the
##	base role template: D-Bus chat and bus name publish.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the D-Bus session resources.
##	</summary>
## </param>
#
interface(`local_xdg_document_portal_role',`
	local_xdg_document_portal_dbus_chat($1_t)
	local_xdg_document_portal_publish_bus_name($1)
')

########################################
## <summary>
##	Allow the XDG document portal to exchange D-Bus messages with a
##	desktop-owned domain (e.g. the client that invoked it, for property
##	queries and method returns).
## </summary>
## <param name="peer_domain">
##	<summary>
##	Domain to exchange messages with.
##	</summary>
## </param>
#
interface(`local_xdg_document_portal_dbus_chat',`
	gen_require(`
		type xdg_document_portal_t;
		class dbus send_msg;
	')

	allow xdg_document_portal_t $1:dbus send_msg;
	allow $1 xdg_document_portal_t:dbus send_msg;
')

########################################
## <summary>
##	Allow the XDG document portal to publish its D-Bus service
##	(org.freedesktop.portal.Documents) on the per-role session bus.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the session D-Bus domain.
##	</summary>
## </param>
#
interface(`local_xdg_document_portal_publish_bus_name',`
	gen_require(`
		type xdg_document_portal_t;
		type $1_dbusd_t;
		class dbus acquire_svc;
	')

	allow xdg_document_portal_t $1_dbusd_t:dbus acquire_svc;
')

########################################
## <summary>
## Allow a user systemd instance to launch the XDG document portal with the
## usual inherited-exec process bits.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the user systemd domain.
##	</summary>
## </param>
#
interface(`local_xdg_document_portal_systemd_inherit',`
	gen_require(`
		type xdg_document_portal_t;
	')

	local_systemd_inherit_user_service($1, xdg_document_portal_t)
')
