## <summary>
##	Role access for PipeWire.
## </summary>
## <param name="role_prefix">
##	<summary>
##	The prefix of the user role, for example staff or user.
##	</summary>
## </param>
## <param name="user_domain">
##	<summary>
##	User domain for the role.
##	</summary>
## </param>
## <param name="user_exec_domain">
##	<summary>
##	User exec domain for execute and transition access.
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access.
##	</summary>
## </param>
#
template(`pipewire_role',`
	gen_require(`
		role $4;
		attribute $3;
		type pipewire_exec_t, pipewire_runtime_t, user_runtime_t;
	')

	type $1_pipewire_t;
	userdom_user_application_domain($1_pipewire_t, pipewire_exec_t)
	role $4 types $1_pipewire_t;

	domtrans_pattern($3, pipewire_exec_t, $1_pipewire_t)

	allow $3 $1_pipewire_t:process { ptrace signal_perms };
	allow $3 $1_pipewire_t:fd use;
	ps_process_pattern($3, $1_pipewire_t)

	allow $1_pipewire_t $3:process sigchld;
	allow $1_pipewire_t self:process getsched;

	auth_use_nsswitch($1_pipewire_t)
	miscfiles_read_localization($1_pipewire_t)
	files_read_usr_files($1_pipewire_t)
	files_map_usr_files($1_pipewire_t)
	userdom_search_user_home_dirs($1_pipewire_t)
	userdom_search_user_home_content($1_pipewire_t)
	userdom_search_user_runtime($1_pipewire_t)
	dbus_all_session_bus_client($1_pipewire_t)
	dbus_write_session_runtime_socket($1_pipewire_t)
	dbus_system_bus_client($1_pipewire_t)
	rtkit_scheduled($1_pipewire_t)

	manage_sock_files_pattern($1_pipewire_t, pipewire_runtime_t, pipewire_runtime_t)
	userdom_user_runtime_filetrans($1_pipewire_t, pipewire_runtime_t, sock_file, "pipewire-0")
	userdom_user_runtime_filetrans($1_pipewire_t, pipewire_runtime_t, sock_file, "pipewire-0-manager")
	stream_connect_pattern($1_pipewire_t, user_runtime_t, pipewire_runtime_t, $1_pipewire_t)

	optional_policy(`
		systemd_user_app_status($1, $1_pipewire_t)
		allow $1_systemd_t $1_pipewire_t:process2 nnp_transition;
	')
')
