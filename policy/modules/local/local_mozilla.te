policy_module(local_mozilla)

gen_require(`
	type alsa_var_lib_t;
	type chromium_t;
	type evince_t;
	type keepassxc_t;
	type mozilla_t;
	type mozilla_tmpfs_t;
	type pipewire_runtime_t;
	type systemd_user_runtime_t;
	type user_runtime_t;
	type var_lib_t;
	type xdg_cache_t;
	type xdg_config_t;
	type xdg_data_t;
	class file map;
')

# Firefox uses the PC/SC runtime socket for smartcard/token access.
pcscd_read_runtime_files(mozilla_t)
pcscd_stream_connect(mozilla_t)

# Low-risk desktop/runtime baseline for Firefox under the current GNOME/KWin
# user session: read dconf/GTK settings, XKB data, and its cgroup state.
gnome_mmap_read_xdg_config_files(mozilla_t)
gnome_watch_xdg_config_dirs(mozilla_t)
xserver_read_xkb_libs(mozilla_t)
fs_search_cgroup_dirs(mozilla_t)
fs_read_cgroup_files(mozilla_t)
files_map_etc_files(mozilla_t)
wm_map_tmpfs_files(mozilla_t)
corenet_tcp_connect_all_ports(mozilla_t)
pulseaudio_client_domain(mozilla_t)
dev_rw_tpm(mozilla_t)
local_tpm2_pkcs11_manage_home_files(mozilla_t)
local_userdomain_dontaudit_generic_home_when_disabled(`mozilla_read_generic_user_content', mozilla_t)

# Firefox creates a per-instance Wayland proxy socket under /run/user/$UID.
allow mozilla_t user_runtime_t:dir { add_name write };
allow mozilla_t user_runtime_t:sock_file { create unlink write };
allow mozilla_t alsa_var_lib_t:dir search;
allow mozilla_t pipewire_runtime_t:sock_file write;

# Hardware-accelerated video decode hands zero-copy frame buffers to the GPU
# process via /dev/udmabuf.
dev_rw_dma_dev(mozilla_t)

# The GPU process creates and mmaps the RADV Vulkan shader-cache index
# (~/.cache/radv_builtin_shaders) under the generic XDG cache label.
allow mozilla_t xdg_cache_t:file { create getattr map open read write };

# Wayland clipboard transfers can pass an inherited pipe fd from Chromium to
# Firefox when pasting between browser domains.
local_clipboard_pipe_write(chromium_t, mozilla_t)
local_clipboard_pipe_write(evince_t, mozilla_t)
local_clipboard_pipe_write(keepassxc_t, mozilla_t)
local_evince_domtrans(mozilla_t)

# Firefox uses same-domain ptrace within its own process tree for sandboxing
# and crash/process management.
allow mozilla_t self:process ptrace;
allow mozilla_t self:process execmem;

dontaudit mozilla_t systemd_user_runtime_t:dir { getattr search };
dontaudit mozilla_t { var_lib_t xdg_config_t xdg_data_t }:dir watch;
