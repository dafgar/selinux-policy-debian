policy_module(local_mozilla)

gen_require(`
	type mozilla_t;
	type mozilla_tmpfs_t;
	type tpm2_pkcs11_home_t;
	type user_runtime_t;
	type var_lib_t;
	type staff_wm_t;
	type xdg_config_t;
	type xdg_data_t;
	class file map;
')

# Firefox uses the PC/SC runtime socket for smartcard/token access.
pcscd_read_runtime_files(mozilla_t)
pcscd_stream_connect(mozilla_t)

# Low-risk desktop/runtime baseline for Firefox under the current GNOME/KWin
# user session: read dconf/GTK settings, XKB data, and its cgroup state.
gnome_mmap_read_xdg_config_files(mozilla_t)
gnome_watch_xdg_config_dirs(mozilla_t)
xserver_read_xkb_libs(mozilla_t)
fs_search_cgroup_dirs(mozilla_t)
fs_read_cgroup_files(mozilla_t)
wm_map_tmpfs_files(mozilla_t)

# Firefox creates a per-instance Wayland proxy socket under /run/user/$UID.
allow mozilla_t user_runtime_t:dir { add_name write };
allow mozilla_t user_runtime_t:sock_file { create unlink write };
allow mozilla_t tpm2_pkcs11_home_t:dir search;

# Firefox uses same-domain ptrace within its own process tree for sandboxing
# and crash/process management.
allow mozilla_t self:process ptrace;
allow mozilla_t self:process execmem;

# KWin maps Firefox-owned Wayland cursor buffers from mozilla_tmpfs_t.
allow staff_wm_t mozilla_tmpfs_t:file map;

dontaudit mozilla_t { var_lib_t xdg_config_t xdg_data_t }:dir watch;
