policy_module(local_systemsettings)

attribute_role systemsettings_roles;

type systemsettings_t;
type systemsettings_exec_t;
userdom_user_application_domain(systemsettings_t, systemsettings_exec_t)
role systemsettings_roles types systemsettings_t;

# Some KCMs (e.g. the "About this System" / online-accounts pages) embed a
# QtWebEngine view sandboxed via a user namespace; the sandboxed renderer
# itself transitions into qtwebengine_t, wired from local_staff.te via
# qtwebengine_role(systemsettings_t, staff_r). Same pattern as khelpcenter
# and mnemosyne.
local_qtwebengine_embed(systemsettings_t)

files_read_usr_files(systemsettings_t)
files_map_usr_files(systemsettings_t)
miscfiles_read_localization(systemsettings_t)
miscfiles_read_fonts(systemsettings_t)
xdg_search_config_dirs(systemsettings_t)
xdg_read_config_files(systemsettings_t)
xdg_watch_config_files(systemsettings_t)
xdg_search_data_dirs(systemsettings_t)
xdg_read_data_files(systemsettings_t)
dbus_all_session_bus_client(systemsettings_t)
dbus_write_session_runtime_socket(systemsettings_t)
systemd_dbus_chat_logind(systemsettings_t)
userdom_search_user_runtime(systemsettings_t)
xserver_use_user_fonts(systemsettings_t)
xserver_rw_mesa_shader_cache(systemsettings_t)
