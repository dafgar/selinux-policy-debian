## <summary>
##	Local GnuPG runtime helpers.
## </summary>

########################################
## <summary>
##	Manage GnuPG runtime directories under the per-user runtime tree.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed to create and populate GnuPG runtime directories.
##	</summary>
## </param>
#
interface(`local_gpg_manage_runtime_dirs',`
	gen_require(`
		type gpg_runtime_t;
	')

	allow $1 gpg_runtime_t:dir { create add_name write };
')

########################################
## <summary>
##	Allow gpg-agent to talk to a user-domain graphical prompter over D-Bus.
## </summary>
## <param name="user_domain">
##	<summary>
##	User domain receiving the graphical prompt requests.
##	</summary>
## </param>
#
interface(`local_gpg_prompter_dbus_chat',`
	gen_require(`
		type gpg_agent_t;
		class dbus send_msg;
	')

	allow gpg_agent_t $1:dbus send_msg;
	allow $1 gpg_agent_t:dbus send_msg;
')
