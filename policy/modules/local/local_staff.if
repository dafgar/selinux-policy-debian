## <summary>
##	Local override module with no exported interfaces.
## </summary>

########################################
## <summary>
##	Allow a domain to read the process state (/proc/pid) of staff_t, e.g.
##	Xwayland reading the cmdline of a connecting X11 client for
##	_NET_WM_PID-style client identification.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`local_staff_read_proc_state',`
	gen_require(`
		type staff_t;
	')

	allow $1 staff_t:dir list_dir_perms;
	read_files_pattern($1, staff_t, staff_t)
	read_lnk_files_pattern($1, staff_t, staff_t)
')

########################################
## <summary>
##	Allow a domain to connect to staff_t's Wayland compositor socket, e.g.
##	an application domain acting as a Wayland client of the session
##	compositor.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`local_staff_wayland_connect',`
	gen_require(`
		type staff_t, staff_wayland_socket_t;
	')

	allow $1 staff_t:unix_stream_socket connectto;
	allow $1 staff_wayland_socket_t:sock_file write;
')

########################################
## <summary>
##	Allow a domain to connect to staff_t's X11 socket, e.g. an application
##	domain acting as an X11 client via Xwayland or a native X11 server.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`local_staff_x11_connect',`
	gen_require(`
		type staff_t, staff_x11_socket_t;
	')

	allow $1 staff_t:unix_stream_socket connectto;
	allow $1 staff_x11_socket_t:sock_file write;
')
