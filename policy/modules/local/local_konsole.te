policy_module(local_konsole)

gen_require(`
	type user_devpts_t;
	type staff_t;
')

attribute_role konsole_roles;

type konsole_t;
type konsole_exec_t;
userdom_user_application_domain(konsole_t, konsole_exec_t)
role konsole_roles types konsole_t;

# konsole is a pass-through: the shell and anything launched from it (git,
# sudo, editors, other GUI apps) need the same ability staff_t has to
# transition into the other per-app role domains, or opening a terminal
# would silently break launching anything else from inside it.
userdom_application_exec_domain(konsole_t, staff)

# Konsole is an interactive terminal emulator, the same role staff_t and
# sysadm_t already play (userdom_restricted_user_template calls this for
# both). Marking konsole_t's fds as privfd lets any domain that already
# calls domain_use_interactive_fds() -- system_dbusd_t, setfiles_t,
# checkpolicy_t, newrole_t, run_init_t, ... -- inherit them without a
# bespoke allow rule per caller.
domain_interactive_fd(konsole_t)

# Konsole itself allocates the pty for each terminal session. staff_t gets a
# user_devpts_t transition via userdom_base_user_template, but konsole_t (a
# plain userdom_user_application_domain) doesn't -- so without this, every
# pty Konsole opens defaults to plain devpts_t, and anything launched inside
# it (ssh_t, staff_git_t, sysadm elevation, ...) only has terminal grants
# scoped to user_devpts_t.
term_create_pty(konsole_t, user_devpts_t)

# Konsole itself needs the system-bus-client Hello handshake and its
# underlying stream_connect_pattern before it can chat with logind below.
dbus_system_bus_client(konsole_t)

# Opening a new terminal session registers it with logind
# (CreateSessionWithPIDFD) over the system bus.
systemd_dbus_chat_logind(konsole_t)

# Only /usr/bin/konsole itself should carry konsole_t. The interactive shell
# it forks per session/tab transitions back to staff_t immediately on exec,
# so everything launched from that shell runs as a normal staff_t process
# (using staff_t's own app-domain-transition rules) instead of inheriting
# Konsole's pty/fd/dbus/logind/sysadm-elevation grants above.
corecmd_shell_domtrans(konsole_t, staff_t)

# systemd-tty-ask-password-agent, run from that elevated sysadm_r shell,
# still inherits the original Konsole pty fd (fd-use checks the domain
# that opened the fd, i.e. konsole_t, regardless of how many further
# transitions the process has been through since). This one's a hardcoded
# allow in the interface, not privfd-based.
systemd_use_passwd_agent_fds(konsole_t)
