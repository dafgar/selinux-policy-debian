policy_module(local_konsole)

type konsole_exec_t;
application_executable_file(konsole_exec_t)

## <desc>
## <p>
## Allow Konsole to make its stack/heap memory executable. Shared across
## every role's konsole_role() instantiation rather than per-role, since
## Konsole itself (not the role prefix) is what determines whether this is
## needed.
## </p>
## </desc>
gen_tunable(konsole_execmem, false)
