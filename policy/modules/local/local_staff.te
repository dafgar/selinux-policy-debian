policy_module(local_staff)

gen_require(`
	type nsfs_t;
	type staff_dbusd_t;
	type staff_t;
	type staff_wm_t;
	type staff_pipewire_t;
')

pipewire_role(staff, staff_t, staff_application_exec_domain, staff_r)
wireplumber_role(staff, staff_t, staff_application_exec_domain, staff_r)

# User-session helpers such as systemctl --user may stat namespace file handles
# during generic runtime probing. Keep this limited to harmless metadata lookup.
dontaudit staff_t nsfs_t:file getattr;

dbus_read_user_activation_services(staff_dbusd_t)
low_mem_mon_dbus_chat(staff_t)

pipewire_stream_connect(staff_t, staff_pipewire_t)
pipewire_stream_connect(staff_wm_t, staff_pipewire_t)
pipewire_pulse_stream_connect(staff_t, staff_pipewire_t)
