policy_module(local_staff)

gen_require(`
	type gkrellm_t;
	type khelpcenter_t;
	type mnemosyne_t;
	type nsfs_t;
	type mozilla_t;
	type plasmashell_t;
	type staff_dbusd_t;
	type staff_git_t;
	type staff_pipewire_t;
	type staff_sudo_t;
	type staff_t;
	type staff_wm_t;
	type staff_xwayland_t;
	type systemd_user_tmpfs_t;
	type systemsettings_t;
	type ssh_home_t;
	type tmp_t;
	type user_devpts_t;
	type xdm_tmp_t;
')

type staff_wayland_socket_t;
userdom_user_tmp_file(staff_wayland_socket_t)
userdom_user_runtime_content(staff_wayland_socket_t)
userdom_user_runtime_filetrans(staff_t, staff_wayland_socket_t, sock_file, "wayland-0")

type staff_x11_socket_t;
userdom_user_tmp_file(staff_x11_socket_t)
filetrans_pattern(staff_t, xdm_tmp_t, staff_x11_socket_t, sock_file, "X0")

pipewire_role(staff, staff_t, staff_application_exec_domain, staff_r)
wireplumber_role(staff, staff_t, staff_application_exec_domain, staff_r)
zotero_role(staff_application_exec_domain, staff_r)
evince_role(staff_application_exec_domain, staff_r)
plasmashell_role(staff_application_exec_domain, staff_r)

# plasmashell is itself a Wayland client of the session's compositor socket
# and a PulseAudio/pipewire client (volume applet, etc); pipewire-pulse in
# turn introspects plasmashell's /proc/<pid> like it does for other
# audio-client app domains.
local_plasmashell_wayland_connect(staff)
local_pipewire_pulse_stream_connect(plasmashell_t, staff_pipewire_t)
ps_process_pattern(staff_pipewire_t, plasmashell_t)
# Plasma broadcasts session-wide signals (KActivities resource scoring,
# KDirNotify file-added notifications) that staff_t receives as a generic
# session bus client.
local_plasmashell_dbus_chat(staff_t)
local_plasmashell_gvfs_dbus_chat(staff)
powerdevil_role(staff_application_exec_domain, staff_r)
local_powerdevil_dbus_chat(staff_t)
# org_kde_powerdevil is an X11 client (via Xwayland) of the session X11
# socket, and also probes the Wayland compositor socket directly (Qt QPA
# platform detection).
local_powerdevil_x11_connect(staff)
local_powerdevil_wayland_connect(staff)
kdeconnect_role(staff_application_exec_domain, staff_r)
local_kdeconnect_dbus_activation(staff)
# kdeconnectd is a Wayland client of the session compositor socket, e.g. for
# tray/notification integration.
local_kdeconnect_wayland_connect(staff)
safeeyes_role(staff_application_exec_domain, staff_r)
rsibreak_role(staff_application_exec_domain, staff_r)
local_rsibreak_dbus_chat(staff_t)
local_rsibreak_x11_connect(staff_t)
local_rsibreak_wayland_connect(staff)
local_rsibreak_publish_bus_name(staff)
keepassxc_role(staff_application_exec_domain, staff_r)
gkrellm_role(staff_application_exec_domain, staff_r)
discover_notifier_role(staff_application_exec_domain, staff_r)
# DiscoverNotifier is an X11 client (via Xwayland) of the session X11
# socket, and also probes the Wayland compositor socket directly (Qt QPA
# platform detection).
local_discover_notifier_x11_connect(staff)
local_discover_notifier_wayland_connect(staff)
xdg_document_portal_role(staff_application_exec_domain, staff_r)
local_xdg_document_portal_dbus_chat(staff_t)
local_xdg_document_portal_publish_bus_name(staff)
xdg_desktop_portal_role(staff_application_exec_domain, staff_r)
local_xdg_desktop_portal_dbus_chat(staff_t)
local_xdg_desktop_portal_publish_bus_name(staff)
kioworker_role(staff_application_exec_domain, staff_r)
kscreenlocker_role(staff_application_exec_domain, staff_r)
qtwebengine_role(staff_application_exec_domain, staff_r)
qtwebengine_role(plasmashell_t, staff_r)
khelpcenter_role(staff_application_exec_domain, staff_r)
qtwebengine_role(khelpcenter_t, staff_r)
systemsettings_role(staff_application_exec_domain, staff_r)
qtwebengine_role(systemsettings_t, staff_r)
mnemosyne_role(staff_application_exec_domain, staff_r)
qtwebengine_role(mnemosyne_t, staff_r)
# Mnemosyne is a Wayland client of the session compositor socket.
local_mnemosyne_wayland_connect(staff)
local_mnemosyne_dbus_chat(staff_t)
dolphin_role(staff_application_exec_domain, staff_r)
spectacle_role(staff_application_exec_domain, staff_r)
gstpluginscanner_role(staff_application_exec_domain, staff_r)
ktorrent_role(staff_application_exec_domain, staff_r)
gimp_role(staff_application_exec_domain, staff_r)
konsole_role(staff, staff_t, staff_application_exec_domain, staff_r)
local_konsole_systemd_dbus_chat(staff)
local_konsole_dbus_chat(staff, staff_t)
local_konsole_dbus_chat(staff, xdg_desktop_portal_t)
local_konsole_publish_bus_name(staff)
# Transition into the base-policy ping domain instead of granting icmp_socket
# use directly on staff_t.
netutils_run_ping(staff_t, staff_r)
local_evince_x11_connect(staff_t)
local_evince_dbus_chat(staff_t)
local_evince_gvfs_dbus_chat(staff)

# User-session helpers such as systemctl --user may stat namespace file handles
# during generic runtime probing. Keep this limited to harmless metadata lookup.
dontaudit staff_t nsfs_t:file getattr;

# goa-identity-service watches /tmp as part of temporary session plumbing.
# Keep this in the noise bucket rather than broadening generic temp access.
dontaudit staff_t tmp_t:dir watch;

# konsole watches ~/.ssh/config for user-session convenience, not core SSH use.
dontaudit staff_t ssh_home_t:file watch;

local_dbus_read_user_activation_services(staff_dbusd_t)
low_mem_mon_dbus_chat(staff_t)
local_powerprofiles_dbus_chat(staff_t)
local_gpg_prompter_dbus_chat(staff_t)

# flatpak --print-updated-env exchanges a systemd-created memfd in the user
# session. Keep this limited to read/write on systemd_user_tmpfs_t files.
allow staff_t systemd_user_tmpfs_t:file rw_file_perms;

# Plasma shell querying Firefox scheduler metadata is desktop integration noise.
dontaudit staff_t mozilla_t:process getsched;

local_git_search_user_paths(staff)
local_git_use_urandom(staff)
local_git_config_lockfile_trans(staff)
local_git_shell_hooks(staff, staff_t)
local_git_dontaudit_pager_history(staff)
gvfs_role(staff, staff_t, staff_application_exec_domain, staff_r)
local_code_role(staff, staff_t)
local_code_git_client(staff)

# The systemd tty password agent may inherit the invoking sudo session tty fd.
systemd_use_passwd_agent_fds(staff_sudo_t)

# sudo's tty-ticket/password-prompt locking on its own controlling terminal.
allow staff_sudo_t user_devpts_t:chr_file lock;

# After a TTY login followed by sudo, logind can retain a sudo-owned inherited
# fd while managing session/seat state; without this, switching back to the
# graphical display can fail. Keep this limited to fd use.
local_systemd_logind_use_inherited_sudo_fds(staff)
local_sudo_dontaudit_runtime_probes(staff)
local_evolution_alarm_desktop(staff_t)
local_evolution_alarm_wayland_connect(staff)
local_mplayer_pipewire_pulse_connect(staff)
local_chromium_pipewire_pulse_connect(staff)
local_chromium_wayland_connect(staff)
local_chromium_mpris_publish(staff)
local_chromium_gvfs_dbus_chat(staff)
local_mplayer_x11_connect(staff_xwayland_t)
local_mplayer_shm(staff_xwayland_t)
local_mplayer_read_proc_state(staff_xwayland_t)
local_mozilla_pipewire_pulse_connect(staff)
local_mozilla_gvfs_dbus_chat(staff)
local_safeeyes_pipewire_connect(staff)
local_safeeyes_dbus_chat(staff_t)
local_safeeyes_gvfs_dbus_chat(staff)
local_thunderbird_pipewire_pulse_connect(staff)
local_thunderbird_pipewire_process_lookup(staff)
local_thunderbird_publish_bus_name(staff)
local_thunderbird_dbus_chat(staff_t)
local_zotero_dbus_chat(staff_t)
# Uncertain whether Zotero's Gecko renderer runs X11-via-Xwayland or native
# Wayland - no dedicated tmpfs type consumed by staff_wm_t (unlike
# evince/evolution_alarm/chromium) and no MIT-SHM grant either way to tell.
# Granting both peers for now; narrow down to one from a fresh AVC log once
# it's actually exercised (see project_xwayland_split_todo memory).
local_zotero_stream_connect(staff_t)
local_zotero_stream_connect(staff_wm_t)
local_zotero_read_home_content(staff_t)
local_zotero_publish_bus_name(staff)
local_keepassxc_read_home_content(staff_t)
local_keepassxc_stream_connect(staff_t)
local_keepassxc_wayland_connect(staff)
local_keepassxc_dbus_chat(staff_t)
local_gkrellm_stream_connect(staff_xwayland_t)
local_gkrellm_x11_connect(staff)
local_gkrellm_shm(staff_xwayland_t)
local_ssh_shm(staff_xwayland_t)
local_xwayland_wm_protocol_socket(staff, staff_wm_t)
local_xwayland_listen_socket(staff, staff_t)
local_systemd_inherit_user_service(staff, staff_xwayland_t)
local_plasmashell_systemd_inherit(staff)
local_staff_read_proc_state(staff_xwayland_t)
local_kioworker_read_proc_state(staff_xwayland_t)
local_powerdevil_read_proc_state(staff_xwayland_t)
local_discover_notifier_read_proc_state(staff_xwayland_t)
local_rsibreak_read_proc_state(staff_xwayland_t)
local_keepassxc_read_proc_state(staff_xwayland_t)
local_gkrellm_read_proc_state(staff_xwayland_t)
local_evolution_alarm_read_proc_state(staff_xwayland_t)
