policy_module(local_staff)

gen_require(`
	type nsfs_t;
	type staff_dbusd_t;
	type staff_git_t;
	type staff_t;
	type staff_wm_t;
	type staff_pipewire_t;
	type systemd_user_tmpfs_t;
	type tmp_t;
')

pipewire_role(staff, staff_t, staff_application_exec_domain, staff_r)
wireplumber_role(staff, staff_t, staff_application_exec_domain, staff_r)
kdeconnect_role(staff, staff_t, staff_application_exec_domain, staff_r)

# User-session helpers such as systemctl --user may stat namespace file handles
# during generic runtime probing. Keep this limited to harmless metadata lookup.
dontaudit staff_t nsfs_t:file getattr;

# goa-identity-service watches /tmp as part of temporary session plumbing.
# Keep this in the noise bucket rather than broadening generic temp access.
dontaudit staff_t tmp_t:dir watch;

dbus_read_user_activation_services(staff_dbusd_t)
low_mem_mon_dbus_chat(staff_t)
powerprofiles_dbus_chat(staff_t)
local_gpg_prompter_dbus_chat(staff_t)

# flatpak --print-updated-env exchanges a systemd-created memfd in the user
# session. Keep this limited to read/write on systemd_user_tmpfs_t files.
allow staff_t systemd_user_tmpfs_t:file rw_file_perms;

local_git_search_user_paths(staff_git_t)
local_git_dontaudit_pager_history(staff_git_t)

pipewire_stream_connect(staff_t, staff_pipewire_t)
pipewire_stream_connect(staff_wm_t, staff_pipewire_t)
pipewire_pulse_stream_connect(staff_t, staff_pipewire_t)
pipewire_rw_tmpfs_files(staff_t)
pipewire_rw_tmpfs_files(staff_wm_t)

# kwin_wayland updates per-user desktop integration artifacts under ~/.local/share.
xdg_manage_data(staff_wm_t)
