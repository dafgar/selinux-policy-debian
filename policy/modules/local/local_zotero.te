policy_module(local_zotero)

attribute_role zotero_roles;

type zotero_t;
type zotero_exec_t;
userdom_user_application_domain(zotero_t, zotero_exec_t)
role zotero_roles types zotero_t;
can_exec(zotero_t, zotero_exec_t)

type zotero_home_t;
userdom_user_home_content(zotero_home_t)

type zotero_xdg_cache_t;
xdg_cache_content(zotero_xdg_cache_t)

type zotero_tmp_t;
files_tmp_file(zotero_tmp_t)

# Zotero's built-in Mozilla-style updater stages updates in place under its
# own install tree (e.g. ~/.local/opt/zotero), including a .parentlock file,
# separate from the /tmp/MozillaUpdateLock-* lock handled below.
type zotero_install_t;
userdom_user_home_content(zotero_install_t)

manage_dirs_pattern(zotero_t, zotero_home_t, zotero_home_t)
mmap_manage_files_pattern(zotero_t, zotero_home_t, zotero_home_t)
manage_lnk_files_pattern(zotero_t, zotero_home_t, zotero_home_t)
allow zotero_t zotero_home_t:dir watch;
userdom_user_home_dir_filetrans_user_home_content(zotero_t, { dir file lnk_file }, ".zotero")

manage_dirs_pattern(zotero_t, zotero_xdg_cache_t, zotero_xdg_cache_t)
manage_files_pattern(zotero_t, zotero_xdg_cache_t, zotero_xdg_cache_t)
manage_lnk_files_pattern(zotero_t, zotero_xdg_cache_t, zotero_xdg_cache_t)
xdg_cache_filetrans(zotero_t, zotero_xdg_cache_t, dir, "zotero")

manage_dirs_pattern(zotero_t, zotero_tmp_t, zotero_tmp_t)
manage_files_pattern(zotero_t, zotero_tmp_t, zotero_tmp_t)
manage_lnk_files_pattern(zotero_t, zotero_tmp_t, zotero_tmp_t)
files_tmp_filetrans(zotero_t, zotero_tmp_t, { dir file }, "zotero")

manage_dirs_pattern(zotero_t, zotero_install_t, zotero_install_t)
manage_files_pattern(zotero_t, zotero_install_t, zotero_install_t)
manage_lnk_files_pattern(zotero_t, zotero_install_t, zotero_install_t)

gen_require(`
	type etc_t;
	type mozilla_exec_t;
	type pcscd_runtime_t;
	type plasmashell_t;
	type pulseaudio_tmp_t;
	type random_device_t;
	type root_t;
	type systemd_machined_runtime_t;
	type system_dbusd_runtime_t;
	type syslogd_runtime_t;
	type tpm2_pkcs11_home_t;
	type thunderbird_exec_t;
	type tmpfs_t;
	type user_home_t;
	type var_lib_t;
	type var_t;
	type usr_t;
	type user_runtime_t;
	type xdg_config_t;
')

miscfiles_read_localization(zotero_t)
kernel_read_system_state(zotero_t)
# Zotero still probes Mozilla/NSS home state for user certificate storage.
mozilla_read_user_home_files(zotero_t)
sysnet_read_config(zotero_t)
files_read_etc_files(zotero_t)
files_read_usr_files(zotero_t)
files_map_usr_files(zotero_t)
files_exec_usr_files(zotero_t)
corecmd_exec_bin(zotero_t)
corecmd_search_bin(zotero_t)
corenet_tcp_bind_all_unreserved_ports(zotero_t)
corenet_tcp_bind_generic_node(zotero_t)
corenet_tcp_connect_http_port(zotero_t)
dbus_spec_session_bus_client(staff, zotero_t)
dbus_connect_system_bus(zotero_t)
dbus_system_bus_client(zotero_t)
dbus_write_session_runtime_socket(zotero_t)
dev_read_sysfs(zotero_t)
dev_read_urand(zotero_t)
fs_getattr_all_fs(zotero_t)
fs_read_cgroup_files(zotero_t)
fs_search_cgroup_dirs(zotero_t)
gnome_mmap_read_xdg_config_files(zotero_t)
gnome_watch_xdg_config_dirs(zotero_t)
logging_search_logs(zotero_t)
logging_send_syslog_msg(zotero_t)
ntp_dbus_chat(zotero_t)
systemd_dbus_chat_logind(zotero_t)
userdom_search_user_home_dirs(zotero_t)
userdom_search_user_home_content(zotero_t)
xdg_manage_downloads(zotero_t)
xdg_read_config_files(zotero_t)
xdg_manage_data(zotero_t)
xdg_read_data_files(zotero_t)
xdg_search_config_dirs(zotero_t)
xdg_search_data_dirs(zotero_t)
userdom_search_user_runtime(zotero_t)
userdom_manage_user_tmp_files(zotero_t)
userdom_map_user_tmp_files(zotero_t)
userdom_write_user_tmp_sockets(zotero_t)
allow zotero_t user_runtime_t:dir { add_name remove_name };
allow zotero_t user_runtime_t:dir write;
allow zotero_t user_runtime_t:sock_file { create unlink write };
allow zotero_t user_tmp_t:dir { getattr search };
allow zotero_t xdg_config_t:dir { read watch };
xserver_stream_connect(zotero_t)
xserver_read_xkb_libs(zotero_t)
xserver_use_user_fonts(zotero_t)
xserver_rw_mesa_shader_cache(zotero_t)
miscfiles_read_fonts(zotero_t)
dev_rw_dri(zotero_t)
wm_map_tmpfs_files(zotero_t)
wm_rw_tmpfs_files(zotero_t)
local_evince_domtrans(zotero_t)
# Wayland clipboard: when the user highlights text in Zotero (primary
# selection) or copies normally, Zotero is handed the write end of a pipe
# plasmashell created and needs to use that fd/write into it, e.g. for the
# plasmashell clipboard-history manager.
local_plasmashell_use_fifo(zotero_t)
# Keep the direct session-bus runtime sockfile write; system-bus runtime access
# is covered via dbus_system_bus_client(zotero_t).
allow zotero_t system_dbusd_runtime_t:sock_file write;
allow zotero_t session_dbusd_runtime_t:sock_file getattr;
allow zotero_t syslogd_runtime_t:dir search;
dontaudit zotero_t random_device_t:chr_file getattr;
dontaudit zotero_t systemd_machined_runtime_t:dir search;
allow zotero_t tmpfs_t:dir search;
allow zotero_t tmpfs_t:file open;
allow zotero_t tmpfs_t:file { read map write };
# MozillaUpdateLock-* is created under /tmp with a variable name, so keep the
# generic tmp_t fallback limited to the exact lock-file operations observed.
allow zotero_t tmp_t:file { create open read lock unlink };
allow zotero_t self:fifo_file { getattr read write };
allow zotero_t self:netlink_route_socket { create_socket_perms nlmsg_read };
allow zotero_t self:process { execmem getsched setcap setsched signal };
allow zotero_t self:unix_dgram_socket create_socket_perms;
allow zotero_t self:unix_stream_socket connectto;
allow zotero_t self:cap_userns { sys_admin sys_chroot };
allow zotero_t self:tcp_socket create_socket_perms;
allow zotero_t self:tcp_socket listen;
allow zotero_t self:tcp_socket { connect getopt };
allow zotero_t self:udp_socket create_socket_perms;
allow zotero_t self:user_namespace create;

dontaudit zotero_t { etc_t root_t usr_t xdg_data_t }:dir watch;
dontaudit zotero_t { var_t var_lib_t }:dir read;
dontaudit zotero_t user_home_t:file read;
dontaudit zotero_t mozilla_exec_t:file execute;
dontaudit zotero_t pcscd_runtime_t:dir search;
dontaudit zotero_t tpm2_pkcs11_home_t:dir search;
dontaudit zotero_t thunderbird_exec_t:file execute;

# Zotero's updater shells out to bash to finish applying an update (matches
# the .parentlock/install-dir writes above -- classic Mozilla-style updater
# behavior).
corecmd_exec_shell(zotero_t)

# Same PulseAudio client access already granted to chromium_t.
allow zotero_t pulseaudio_tmp_t:dir read;
local_pipewire_pulse_read_cookie(zotero_t)
# Unlike the read above, deleting PulseAudio's own runtime dir isn't normal
# client behavior -- chromium_t doesn't need this either. Mute until there's
# a reason to think it's more than a harmless failed cleanup attempt.
dontaudit zotero_t pulseaudio_tmp_t:dir rmdir;
