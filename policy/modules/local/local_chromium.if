## <summary>
## Local Chromium policy adjustments.
## </summary>

########################################
## <summary>
## Wire up all of a role's access to/from Chromium: PipeWire Pulse
## connect, Wayland compositor connect, MPRIS publish, and gvfs
## dbus_chat.
## </summary>
## <param name="role_prefix">
## <summary>
## User role prefix that owns the PipeWire/Wayland/gvfs session
## resources.
## </summary>
## </param>
#
interface(`local_chromium_role',`
	local_chromium_pipewire_pulse_connect($1)
	local_chromium_wayland_connect($1)
	local_chromium_mpris_publish($1)
	local_chromium_gvfs_dbus_chat($1)
')

########################################
## <summary>
## Allow Chromium to connect to the PulseAudio-compatible PipeWire socket for
## a given role prefix.
## </summary>
## <param name="role_prefix">
## <summary>
## User role prefix that owns the PipeWire server domain.
## </summary>
## </param>
#
interface(`local_chromium_pipewire_pulse_connect',`
	gen_require(`
		type chromium_t;
	')

	local_pipewire_pulse_stream_connect(chromium_t, $1_pipewire_t)
')

########################################
## <summary>
## Allow Chromium to connect to a role's session Wayland compositor socket.
## </summary>
## <param name="role_prefix">
## <summary>
## User role prefix that owns the session's Wayland socket.
## </summary>
## </param>
#
interface(`local_chromium_wayland_connect',`
	gen_require(`
		type chromium_t;
	')

	local_$1_wayland_connect(chromium_t)
')

########################################
## <summary>
## Allow Chromium to publish its MPRIS service on the per-role session bus.
## </summary>
## <param name="role_prefix">
## <summary>
## User role prefix that owns the session D-Bus domain.
## </summary>
## </param>
#
interface(`local_chromium_mpris_publish',`
	gen_require(`
		type chromium_t;
		type $1_dbusd_t;
		class dbus acquire_svc;
	')

	allow chromium_t $1_dbusd_t:dbus acquire_svc;
')

########################################
## <summary>
## Allow Chromium to query gvfs for mountable locations from its file
## picker, for a given role prefix.
## </summary>
## <param name="role_prefix">
## <summary>
## User role prefix that owns the gvfs domain.
## </summary>
## </param>
#
interface(`local_chromium_gvfs_dbus_chat',`
	gen_require(`
		type chromium_t;
	')

	local_gvfs_dbus_chat($1, chromium_t)
')
