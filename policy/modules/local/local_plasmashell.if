## <summary>
##	Local Plasma shell (plasmashell) domain interfaces.
## </summary>

########################################
## <summary>
##	Allow a role to transition into the plasmashell application domain.
## </summary>
## <param name="source_domain">
##	<summary>
##	Domain allowed to execute and transition to plasmashell.
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access to the plasmashell domain.
##	</summary>
## </param>
#
interface(`plasmashell_role',`
	gen_require(`
		type plasmashell_t, plasmashell_exec_t;
		role $2;
	')

	role $2 types plasmashell_t;
	domtrans_pattern($1, plasmashell_exec_t, plasmashell_t)

	allow $1 plasmashell_t:fd use;
	allow $1 plasmashell_t:process { ptrace signal_perms };
	ps_process_pattern($1, plasmashell_t)

	allow plasmashell_t $1:process sigchld;
')

########################################
## <summary>
##	Allow plasmashell to connect to the PulseAudio-compatible PipeWire
##	socket for a given role prefix.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the PipeWire server domain.
##	</summary>
## </param>
#
interface(`local_plasmashell_pipewire_pulse_connect',`
	gen_require(`
		type plasmashell_t;
	')

	local_pipewire_pulse_stream_connect(plasmashell_t, $1_pipewire_t)
	ps_process_pattern($1_pipewire_t, plasmashell_t)
')

########################################
## <summary>
##	Wire up all of a role access to/from plasmashell: Wayland compositor
##	connect, PipeWire Pulse connect, D-Bus chat, gvfs dbus_chat, and
##	systemd inherited-exec launch.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the Wayland/PipeWire/D-Bus/gvfs/systemd
##	session resources.
##	</summary>
## </param>
#
interface(`local_plasmashell_role',`
	# plasmashell is itself a Wayland client of the session compositor
	# socket and a PulseAudio/pipewire client (volume applet, etc);
	# pipewire-pulse in turn introspects the plasmashell /proc/<pid> like it
	# does for other audio-client app domains.
	local_plasmashell_wayland_connect($1)
	local_plasmashell_pipewire_pulse_connect($1)
	# Plasma broadcasts session-wide signals (KActivities resource scoring,
	# KDirNotify file-added notifications) that the role main domain
	# receives as a generic session bus client.
	local_plasmashell_dbus_chat($1_t)
	local_plasmashell_gvfs_dbus_chat($1)
	local_plasmashell_systemd_inherit($1)
')

########################################
## <summary>
##	Allow a user systemd instance to launch plasmashell with the usual
##	inherited-exec process bits.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the user systemd domain.
##	</summary>
## </param>
#
interface(`local_plasmashell_systemd_inherit',`
	gen_require(`
		type plasmashell_t;
	')

	local_systemd_inherit_user_service($1, plasmashell_t)
	allow plasmashell_t $1_systemd_t:unix_stream_socket { getattr ioctl };
')

########################################
## <summary>
##	Send and receive D-Bus messages with PlasmaShell, e.g. a
##	StatusNotifierItem tray icon or the Notifications/PlasmaShell dashboard
##	interfaces.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed to exchange D-Bus messages with PlasmaShell.
##	</summary>
## </param>
#
interface(`local_plasmashell_dbus_chat',`
	gen_require(`
		type plasmashell_t;
		class dbus send_msg;
	')

	allow $1 plasmashell_t:dbus send_msg;
	allow plasmashell_t $1:dbus send_msg;
')

########################################
## <summary>
##	Allow Plasma to query gvfs for mountable locations (e.g. Dolphin's
##	"Network" places, or the storage notifier applet), for a given role
##	prefix.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the gvfs domain.
##	</summary>
## </param>
#
interface(`local_plasmashell_gvfs_dbus_chat',`
	gen_require(`
		type plasmashell_t;
	')

	local_gvfs_dbus_chat($1, plasmashell_t)
')

########################################
## <summary>
##	Allow a domain to read/write plasmashell's fifo pipes, e.g. kwin_wayland
##	signaling plasmashell over an anonymous pipe.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`local_plasmashell_use_fifo',`
	gen_require(`
		type plasmashell_t;
	')

	# The compositor passes the write end of the pipe fd to the copy-source
	# client over Wayland (SCM_RIGHTS); using an fd created by a different
	# domain needs fd:use in addition to the fifo_file perms below.
	allow $1 plasmashell_t:fd use;
	allow $1 plasmashell_t:fifo_file { getattr read write };
')

########################################
## <summary>
##	Allow plasmashell to connect to a role's session Wayland compositor
##	socket.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the session's Wayland socket.
##	</summary>
## </param>
#
interface(`local_plasmashell_wayland_connect',`
	gen_require(`
		type plasmashell_t;
	')

	local_$1_wayland_connect(plasmashell_t)
')

