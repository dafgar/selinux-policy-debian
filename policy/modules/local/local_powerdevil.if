## <summary>
## Local PowerDevil domain interfaces.
## </summary>

########################################
## <summary>
##	Allow a role to transition into the PowerDevil application domain.
## </summary>
## <param name="source_domain">
##	<summary>
##	Domain allowed to execute and transition to PowerDevil.
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access to the PowerDevil domain.
##	</summary>
## </param>
#
interface(`powerdevil_role',`
	gen_require(`
		type powerdevil_t, powerdevil_exec_t;
		role $2;
	')

	role $2 types powerdevil_t;
	domtrans_pattern($1, powerdevil_exec_t, powerdevil_t)

	allow $1 powerdevil_t:process { ptrace signal_perms };
	allow $1 powerdevil_t:fd use;
	ps_process_pattern($1, powerdevil_t)

	allow powerdevil_t $1:process sigchld;
')

########################################
## <summary>
## Allow a user systemd instance to launch PowerDevil with the usual
## inherited-exec process bits.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the user systemd domain.
##	</summary>
## </param>
#
interface(`local_powerdevil_systemd_inherit',`
	gen_require(`
		type powerdevil_t;
	')

	local_systemd_inherit_user_service($1, powerdevil_t)
	allow powerdevil_t $1_systemd_t:unix_stream_socket { getattr ioctl };
')

########################################
## <summary>
##	Wire up all of a role access to/from PowerDevil beyond the base role
##	template: D-Bus chat, X11 connect, Wayland compositor connect, and
##	the role Xwayland domain reading process state.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the D-Bus/X11/Wayland/Xwayland session
##	resources.
##	</summary>
## </param>
#
interface(`local_powerdevil_role',`
	local_powerdevil_dbus_chat($1_t)
	# org_kde_powerdevil is an X11 client (via Xwayland) of the session X11
	# socket, and also probes the Wayland compositor socket directly (Qt QPA
	# platform detection).
	local_powerdevil_x11_connect($1)
	local_powerdevil_wayland_connect($1)
	local_powerdevil_read_proc_state($1_xwayland_t)
')

########################################
## <summary>
##	Send and receive D-Bus messages with PowerDevil, e.g. to inhibit
##	screen/system idle during media playback.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed to exchange D-Bus messages with PowerDevil.
##	</summary>
## </param>
#
interface(`local_powerdevil_dbus_chat',`
	gen_require(`
		type powerdevil_t;
	')

	allow $1 powerdevil_t:dbus send_msg;
	allow powerdevil_t $1:dbus send_msg;
')

########################################
## <summary>
##	Allow PowerDevil to connect to a role's session X11 socket.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the session's X11 socket.
##	</summary>
## </param>
#
interface(`local_powerdevil_x11_connect',`
	gen_require(`
		type powerdevil_t;
	')

	local_$1_x11_connect(powerdevil_t)
')

########################################
## <summary>
##	Allow PowerDevil to connect to a role's session Wayland compositor
##	socket.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the session's Wayland socket.
##	</summary>
## </param>
#
interface(`local_powerdevil_wayland_connect',`
	gen_require(`
		type powerdevil_t;
	')

	local_$1_wayland_connect(powerdevil_t)
')

########################################
## <summary>
##	Allow a domain to read PowerDevil's process state (/proc/pid), e.g.
##	Xwayland reading the cmdline of a connecting X11 client for
##	_NET_WM_PID-style client identification.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`local_powerdevil_read_proc_state',`
	gen_require(`
		type powerdevil_t;
	')

	allow $1 powerdevil_t:dir list_dir_perms;
	read_files_pattern($1, powerdevil_t, powerdevil_t)
	read_lnk_files_pattern($1, powerdevil_t, powerdevil_t)
')
