## <summary>
##	Local gcr-prompter (passphrase/PIN dialog) domain interfaces.
## </summary>

########################################
## <summary>
##	Allow a role to transition into the gcr-prompter domain.
## </summary>
## <param name="source_domain">
##	<summary>
##	Domain allowed to execute and transition to gcr-prompter.
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access to the gcr-prompter domain.
##	</summary>
## </param>
#
interface(`gcr_prompter_role',`
	gen_require(`
		type gcr_prompter_t, gcr_prompter_exec_t;
		role $2;
	')

	role $2 types gcr_prompter_t;
	domtrans_pattern($1, gcr_prompter_exec_t, gcr_prompter_t)

	allow $1 gcr_prompter_t:process { ptrace signal_perms };
	allow $1 gcr_prompter_t:fd use;
	ps_process_pattern($1, gcr_prompter_t)

	allow gcr_prompter_t $1:process sigchld;
')

########################################
## <summary>
##	Wire up all of a role access to/from gcr-prompter beyond the base role
##	template: D-Bus activation by the session bus, D-Bus chat with the
##	role main domain and its keyring daemon, and Wayland compositor connect.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the session D-Bus and Wayland resources.
##	</summary>
## </param>
#
interface(`local_gcr_prompter_role',`
	gen_require(`
		type gcr_prompter_t, gcr_prompter_exec_t, $1_gkeyringd_t;
	')

	dbus_spec_session_domain($1, gcr_prompter_t, gcr_prompter_exec_t)
	local_gcr_prompter_dbus_chat($1_t)
	local_gcr_prompter_dbus_chat($1_gkeyringd_t)
	local_gcr_prompter_wayland_connect($1)
	# GIO startup queries gvfsd MountTracker and the volume monitor; an
	# unanswered call leaves the prompter without a dialog.
	local_gvfs_dbus_chat($1, gcr_prompter_t)
')

########################################
## <summary>
##	Allow bidirectional D-Bus method call/reply between a domain and
##	gcr-prompter.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed to exchange D-Bus messages with gcr-prompter.
##	</summary>
## </param>
#
interface(`local_gcr_prompter_dbus_chat',`
	gen_require(`
		type gcr_prompter_t;
	')

	allow $1 gcr_prompter_t:dbus send_msg;
	allow gcr_prompter_t $1:dbus send_msg;
')

########################################
## <summary>
##	Allow gcr-prompter to connect to a role session Wayland compositor
##	socket.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the session Wayland socket.
##	</summary>
## </param>
#
interface(`local_gcr_prompter_wayland_connect',`
	gen_require(`
		type gcr_prompter_t;
	')

	local_$1_wayland_connect(gcr_prompter_t)
')
