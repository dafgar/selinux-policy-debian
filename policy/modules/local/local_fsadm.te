policy_module(local_fsadm)

gen_require(`
	type fsadm_t;
	role sysadm_r;
')

# Disk-prep helper scripts run under fsadm_t (e.g. via parted/partprobe) probe
# for dmidecode/udevadm with a plain existence check, then transition into
# their own base-policy domains to run them.
dmidecode_run(fsadm_t, sysadm_r)
udev_run_udevadm(fsadm_t, sysadm_r)

# partprobe queries kernel SysV IPC info on startup; standard util-linux probe.
kernel_get_sysvipc_info(fsadm_t)
