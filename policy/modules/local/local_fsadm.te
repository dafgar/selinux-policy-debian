policy_module(local_fsadm)

gen_require(`
	type fsadm_t;
	type dmidecode_exec_t;
	type udevadm_t;
	role sysadm_r;
')

# Disk-prep helper scripts run under fsadm_t (e.g. via parted/partprobe) probe
# for dmidecode with a plain existence check, then execute it in place (no
# domain transition); udevadm gets its own domain instead, since it needs a
# nontrivial set of perms (netlink socket, udevd control socket, file_contexts).
can_exec(fsadm_t, dmidecode_exec_t)
udev_run_udevadm(fsadm_t, sysadm_r)

# partprobe queries kernel SysV IPC info on startup; standard util-linux probe.
kernel_get_sysvipc_info(fsadm_t)

# udevadm settle opens and binds a netlink socket to the kernel's SELinux
# subsystem; not granted to udevadm_t by base policy.
allow udevadm_t self:netlink_selinux_socket create_socket_perms;
