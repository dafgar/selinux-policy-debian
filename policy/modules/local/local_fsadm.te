policy_module(local_fsadm)

gen_require(`
	type fsadm_t;
	type udev_exec_t;
	type dmidecode_exec_t;
')

# Disk-prep helper scripts run under fsadm_t (e.g. via parted/partprobe) probe
# for optional tools with a plain existence check before invoking them.
allow fsadm_t udev_exec_t:file getattr;
allow fsadm_t dmidecode_exec_t:file getattr;

# partprobe queries kernel SysV IPC info on startup; standard util-linux probe.
kernel_get_sysvipc_info(fsadm_t)
