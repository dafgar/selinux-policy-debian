## <summary>
##	Local Mozilla adjustments.
## </summary>

########################################
## <summary>
##	Allow Firefox to connect to a PipeWire Pulse-compatible socket.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the PipeWire server domain.
##	</summary>
## </param>
#
interface(`local_mozilla_pipewire_pulse_connect',`
	gen_require(`
		type mozilla_t;
	')

	local_pipewire_pulse_stream_connect(mozilla_t, $1_pipewire_t)
')

########################################
## <summary>
##	Allow Firefox to query gvfs for mountable locations from its file
##	picker, for a given role prefix.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the gvfs domain.
##	</summary>
## </param>
#
interface(`local_mozilla_gvfs_dbus_chat',`
	gen_require(`
		type mozilla_t;
	')

	local_gvfs_dbus_chat($1, mozilla_t)
')

########################################
## <summary>
##	Allow Firefox to connect to a role's session Wayland compositor socket.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the session's Wayland socket.
##	</summary>
## </param>
#
interface(`local_mozilla_wayland_connect',`
	gen_require(`
		type mozilla_t;
	')

	local_$1_wayland_connect(mozilla_t)
')

########################################
## <summary>
##	Wire up all of a role's access to/from Firefox: PipeWire Pulse
##	connect, gvfs dbus_chat, Wayland compositor connect, the role's
##	Xwayland domain reading Firefox's MIT-SHM segment and process state,
##	and desktop-integration noise dontaudits.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the PipeWire/gvfs/Wayland/Xwayland session
##	resources.
##	</summary>
## </param>
#
interface(`local_mozilla_role',`
	gen_require(`
		type mozilla_t;
	')

	local_mozilla_pipewire_pulse_connect($1)
	local_mozilla_gvfs_dbus_chat($1)
	local_mozilla_wayland_connect($1)
	local_mozilla_shm($1_xwayland_t)
	local_mozilla_read_proc_state($1_xwayland_t)

	# Plasma shell querying Firefox scheduler metadata is desktop integration noise.
	dontaudit $1_t mozilla_t:process getsched;
')

########################################
## <summary>
##	Allow a window-manager domain to map Firefox tmpfs buffers.
## </summary>
## <param name="wm_domain">
##	<summary>
##	Window-manager domain mapping the buffers.
##	</summary>
## </param>
#
interface(`local_mozilla_wm_tmpfs_map',`
	gen_require(`
		type mozilla_tmpfs_t;
		class file map;
	')

	allow $1 mozilla_tmpfs_t:file map;
')

########################################
## <summary>
##	Allow a domain to read/write Firefox's MIT-SHM segment, e.g. the X
##	server attaching to a shared-memory image passed via XShmAttach.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`local_mozilla_shm',`
	gen_require(`
		type mozilla_t;
	')

	allow $1 mozilla_t:shm rw_shm_perms;
')

########################################
## <summary>
##	Allow a domain to read the process state (/proc/pid) of Firefox, e.g.
##	Xwayland reading a connecting client's cmdline for client
##	identification.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`local_mozilla_read_proc_state',`
	gen_require(`
		type mozilla_t;
	')

	allow $1 mozilla_t:dir list_dir_perms;
	read_files_pattern($1, mozilla_t, mozilla_t)
	read_lnk_files_pattern($1, mozilla_t, mozilla_t)
')
