## <summary>
##	Local Mozilla adjustments.
## </summary>

########################################
## <summary>
##	Allow Firefox to connect to a PipeWire Pulse-compatible socket.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the PipeWire server domain.
##	</summary>
## </param>
#
interface(`local_mozilla_pipewire_pulse_connect',`
	gen_require(`
		type mozilla_t;
	')

	local_pipewire_pulse_stream_connect(mozilla_t, $1_pipewire_t)
')

########################################
## <summary>
##	Allow Firefox to query gvfs for mountable locations from its file
##	picker, for a given role prefix.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the gvfs domain.
##	</summary>
## </param>
#
interface(`local_mozilla_gvfs_dbus_chat',`
	gen_require(`
		type mozilla_t;
	')

	local_gvfs_dbus_chat($1, mozilla_t)
')

########################################
## <summary>
##	Allow a window-manager domain to map Firefox tmpfs buffers.
## </summary>
## <param name="wm_domain">
##	<summary>
##	Window-manager domain mapping the buffers.
##	</summary>
## </param>
#
interface(`local_mozilla_wm_tmpfs_map',`
	gen_require(`
		type mozilla_tmpfs_t;
		class file map;
	')

	allow $1 mozilla_tmpfs_t:file map;
')
