## <summary>
##	Local Thunderbird policy adjustments.
## </summary>

########################################
## <summary>
##	Allow Thunderbird to connect to a PipeWire Pulse-compatible socket.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the PipeWire server domain.
##	</summary>
## </param>
#
interface(`local_thunderbird_pipewire_pulse_connect',`
	gen_require(`
		type thunderbird_t;
	')

	pipewire_pulse_stream_connect(thunderbird_t, $1_pipewire_t)
')

########################################
## <summary>
##	Allow a PipeWire domain to inspect Thunderbird through /proc.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the PipeWire domain.
##	</summary>
## </param>
#
interface(`local_thunderbird_pipewire_process_lookup',`
	gen_require(`
		type thunderbird_t;
	')

	ps_process_pattern($1_pipewire_t, thunderbird_t)
')

########################################
## <summary>
## Allow a user systemd instance to launch Thunderbird with the usual
## inherited-exec process bits.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the user systemd domain.
##	</summary>
## </param>
#
interface(`local_thunderbird_systemd_inherit',`
	gen_require(`
		type thunderbird_t;
	')

	local_systemd_inherit_user_service($1, thunderbird_t)
')

########################################
## <summary>
##	Allow Thunderbird to publish its session bus name.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the session D-Bus daemon.
##	</summary>
## </param>
#
interface(`local_thunderbird_publish_bus_name',`
	gen_require(`
		type thunderbird_t;
		type $1_dbusd_t;
	')

	allow thunderbird_t $1_dbusd_t:dbus acquire_svc;
')

########################################
## <summary>
##	Allow Thunderbird to chat with a peer desktop service over D-Bus.
## </summary>
## <param name="peer_domain">
##	<summary>
##	Desktop service domain, such as staff_t.
##	</summary>
## </param>
#
interface(`local_thunderbird_dbus_chat',`
	gen_require(`
		type thunderbird_t;
	')

	allow thunderbird_t $1:dbus send_msg;
	allow $1 thunderbird_t:dbus send_msg;
')

########################################
## <summary>
##	Dontaudit a WM domain using Thunderbird tmpfs buffers and inherited fds.
## </summary>
## <param name="wm_domain">
##	<summary>
##	Window-manager domain using Thunderbird-owned objects.
##	</summary>
## </param>
#
interface(`local_thunderbird_wm_dontaudit_tmpfs_use',`
	gen_require(`
		type thunderbird_t;
		type thunderbird_tmpfs_t;
		class fd use;
	')

	dontaudit $1 thunderbird_tmpfs_t:file { getattr map read write };
	dontaudit $1 thunderbird_t:fd use;
')

########################################
## <summary>
##	Allow a Wayland clipboard peer to write Thunderbird-owned transfer pipes.
## </summary>
## <param name="domain">
##	<summary>
##	Domain writing clipboard data into Thunderbird's inherited pipe.
##	</summary>
## </param>
#
interface(`local_thunderbird_write_wayland_clipboard_pipes',`
	gen_require(`
		type thunderbird_t;
	')

	allow $1 thunderbird_t:fd use;
	allow $1 thunderbird_t:fifo_file write_inherited_fifo_file_perms;
')

########################################
## <summary>
##	Allow a domain to read attachments Thunderbird staged in its per-pid
##	temporary directory (e.g. a viewer opening an attachment Thunderbird
##	handed off).
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed read access.
##	</summary>
## </param>
#
interface(`local_thunderbird_read_tmp_content',`
	gen_require(`
		type thunderbird_tmp_t;
	')

	list_dirs_pattern($1, thunderbird_tmp_t, thunderbird_tmp_t)
	read_files_pattern($1, thunderbird_tmp_t, thunderbird_tmp_t)
	allow $1 thunderbird_tmp_t:file map;
')
