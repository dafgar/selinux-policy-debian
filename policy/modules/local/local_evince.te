policy_module(local_evince)

attribute_role evince_roles;

type evince_t;
type evince_exec_t;
userdom_user_application_domain(evince_t, evince_exec_t)
role evince_roles types evince_t;
can_exec(evince_t, evince_exec_t)

type evince_xdg_config_t;
xdg_config_content(evince_xdg_config_t)

type evince_xdg_cache_t;
xdg_cache_content(evince_xdg_cache_t)

type evince_tmp_t;
files_tmp_file(evince_tmp_t)

# Native Wayland clients hand cursor pixel data to the compositor through an
# anonymous memfd; memfd objects inherit their label from tmpfs transitions,
# not from *.fc, so give evince its own tmpfs type instead of generic tmpfs_t.
type evince_tmpfs_t;
userdom_user_tmpfs_file(evince_tmpfs_t)

manage_dirs_pattern(evince_t, evince_xdg_config_t, evince_xdg_config_t)
manage_files_pattern(evince_t, evince_xdg_config_t, evince_xdg_config_t)
xdg_config_filetrans(evince_t, evince_xdg_config_t, dir, "evince")

manage_dirs_pattern(evince_t, evince_xdg_cache_t, evince_xdg_cache_t)
manage_files_pattern(evince_t, evince_xdg_cache_t, evince_xdg_cache_t)
xdg_cache_filetrans(evince_t, evince_xdg_cache_t, dir, "evince")

manage_dirs_pattern(evince_t, evince_tmp_t, evince_tmp_t)
manage_files_pattern(evince_t, evince_tmp_t, evince_tmp_t)
files_tmp_filetrans(evince_t, evince_tmp_t, { dir file })

manage_files_pattern(evince_t, evince_tmpfs_t, evince_tmpfs_t)
allow evince_t evince_tmpfs_t:file map;
fs_tmpfs_filetrans(evince_t, evince_tmpfs_t, file)

miscfiles_read_localization(evince_t)
miscfiles_read_fonts(evince_t)
kernel_read_system_state(evince_t)
files_read_etc_files(evince_t)
files_read_usr_files(evince_t)
files_map_usr_files(evince_t)
corecmd_search_bin(evince_t)
dev_read_sysfs(evince_t)
dev_read_urand(evince_t)
dev_rw_dri(evince_t)
fs_getattr_all_fs(evince_t)
dbus_spec_session_bus_client(staff, evince_t)
dbus_write_session_runtime_socket(evince_t)
systemd_dbus_chat_logind(evince_t)
local_gvfs_dbus_chat(staff, evince_t)

# glib/D-Bus GUID lookup: checks the legacy /var/lib/dbus/machine-id path
# first, falling back to /etc/machine-id.
dbus_read_lib_files(evince_t)
files_read_etc_runtime_files(evince_t)

# Some GTK/Cairo/audio paths still use classic SysV shared memory alongside
# the memfd path handled above.
allow evince_t self:shm create_shm_perms;

# Evince opens documents from anywhere under the user's home directory, not
# just a dedicated app subdirectory, so it needs general read access to
# home content in addition to its own config/cache/tmp types above.
userdom_search_user_home_dirs(evince_t)
userdom_search_user_home_content(evince_t)
userdom_read_user_home_content_files(evince_t)
userdom_search_user_runtime(evince_t)
userdom_manage_user_tmp_files(evince_t)
userdom_map_user_tmp_files(evince_t)
userdom_use_inherited_user_terminals(evince_t)
# The Wayland socket path itself can land under user_tmp_t; connecting to it
# needs write on the socket file in addition to the connectto grant on the
# compositor's socket object (see local_evince_x11_connect in local_staff.te).
userdom_write_user_tmp_sockets(evince_t)

# Documents opened from another confined app's own storage need explicit
# read access to that app's content type - generic user_home_t grants above
# don't cover it.
local_zotero_read_home_content(evince_t)
local_thunderbird_read_tmp_content(evince_t)

xdg_read_config_files(evince_t)
xdg_search_config_dirs(evince_t)
xdg_search_data_dirs(evince_t)
xdg_manage_data(evince_t)
xdg_manage_downloads(evince_t)

# GTK/GSettings config (e.g. ~/.config/dconf, ~/.config/gtk-3.0) is labeled
# gnome_xdg_config_t, a distinct type from the generic xdg_config_t above.
gnome_mmap_read_xdg_config_files(evince_t)
gnome_watch_xdg_config_dirs(evince_t)

xserver_stream_connect(evince_t)
xserver_read_xkb_libs(evince_t)
xserver_use_user_fonts(evince_t)
xserver_rw_mesa_shader_cache(evince_t)
wm_map_tmpfs_files(evince_t)
wm_rw_tmpfs_files(evince_t)

allow evince_t self:process { execmem getsched signal };
allow evince_t self:unix_dgram_socket create_socket_perms;
allow evince_t self:fifo_file rw_fifo_file_perms;

gen_require(`
	type etc_t;
	type evolution_exec_t;
	type root_t;
	type selinux_config_t;
	type staff_systemd_t;
	type thunderbird_exec_t;
	type user_bin_t;
	type usr_t;
	type var_lib_t;
	type var_t;
	type xdg_config_t;
	type xdg_data_t;
	type xdg_downloads_t;
	type zotero_t;
')

# libselinux's is_selinux_enabled()-style probe; evince works fine treating
# denial as "SELinux disabled", and no other local app needs a real grant.
dontaudit evince_t selinux_config_t:dir search;

# PATH probing of ~/bin for an optional helper that isn't installed.
dontaudit evince_t user_bin_t:dir search;

# GIO "Open With"/content-type app-chooser validates other apps' Exec=
# targets; same noise Zotero already dontaudits for the same reason.
dontaudit evince_t { thunderbird_exec_t evolution_exec_t }:file { execute getattr };

# GIO app-database/desktop-file live-refresh watches across unrelated system
# locations (Flatpak install, desktop-file dirs, XDG config/downloads,
# walking up to the root dir) - cosmetic "Open With" menu upkeep, not
# required to view a document.
dontaudit evince_t { etc_t root_t usr_t var_lib_t xdg_config_t xdg_data_t xdg_downloads_t }:dir watch;
dontaudit evince_t { var_lib_t var_t }:dir read;

# Un-CLOEXEC'd fds leaked across exec from whichever process launched
# evince (Zotero's Electron process, or a systemd-launched ancestor's
# journal-stream socket). Evince keeps working normally when these are
# denied - not a channel it depends on.
dontaudit evince_t zotero_t:unix_stream_socket { read write };
dontaudit evince_t staff_systemd_t:unix_stream_socket { read append };
