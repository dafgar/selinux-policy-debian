policy_module(local_dante)

gen_require(`
	type dante_t;
')

type local_dante_tmp_t;
files_tmp_file(local_dante_tmp_t)

type dante_port_t;
corenet_port(dante_port_t)

# danted creates short-lived shared-memory-like files under /tmp with dynamic
# .sockdshmemXXXX names. Keep them on a dedicated tmp type rather than granting
# the daemon broad management of generic tmp_t.
manage_dirs_pattern(dante_t, local_dante_tmp_t, local_dante_tmp_t)
manage_files_pattern(dante_t, local_dante_tmp_t, local_dante_tmp_t)
allow dante_t local_dante_tmp_t:file map;
files_tmp_filetrans(dante_t, local_dante_tmp_t, file)

# danted queries and adjusts its own scheduling policy during startup.
allow dante_t self:process { getsched setsched };

# Bind only ports that an administrator explicitly maps to dante_port_t
# with semanage port, rather than hardwiring a numeric port choice here.
allow dante_t dante_port_t:tcp_socket name_bind;
