## <summary>
##	Local KeepassXC domain interfaces.
## </summary>

########################################
## <summary>
##	Allow a role to transition into the KeepassXC application domain.
## </summary>
## <param name="source_domain">
##	<summary>
##	Domain allowed to execute and transition to KeepassXC.
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access to the KeepassXC domain.
##	</summary>
## </param>
#
interface(`keepassxc_role',`
	gen_require(`
		type keepassxc_t, keepassxc_exec_t;
		role $2;
	')

	role $2 types keepassxc_t;
	domtrans_pattern($1, keepassxc_exec_t, keepassxc_t)

	allow $1 keepassxc_t:process { ptrace signal_perms };
	allow $1 keepassxc_t:fd use;
	ps_process_pattern($1, keepassxc_t)

	allow keepassxc_t $1:process sigchld;
')

########################################
## <summary>
## Allow a user systemd instance to launch KeepassXC with the usual
## inherited-exec process bits.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the user systemd domain.
##	</summary>
## </param>
#
interface(`local_keepassxc_systemd_inherit',`
	gen_require(`
		type keepassxc_t;
	')

	local_systemd_inherit_user_service($1, keepassxc_t)
')

########################################
## <summary>
##	Wire up all of a role's access to/from KeepassXC beyond the base
##	role template: home content read, stream connect, Wayland compositor
##	connect, D-Bus chat, and the role's Xwayland domain reading process
##	state.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the Wayland/Xwayland session resources.
##	</summary>
## </param>
#
interface(`local_keepassxc_role',`
	local_keepassxc_read_home_content($1_t)
	local_keepassxc_stream_connect($1_t)
	local_keepassxc_wayland_connect($1)
	local_keepassxc_dbus_chat($1_t)
	local_keepassxc_read_proc_state($1_xwayland_t)
')

########################################
## <summary>
##	Allow a domain to read documents stored under KeepassXC's home content
##	(e.g. the interactive user browsing the vault directory directly).
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed read access.
##	</summary>
## </param>
#
interface(`local_keepassxc_read_home_content',`
	gen_require(`
		type keepassxc_home_t;
	')

	list_dirs_pattern($1, keepassxc_home_t, keepassxc_home_t)
	read_files_pattern($1, keepassxc_home_t, keepassxc_home_t)
	read_lnk_files_pattern($1, keepassxc_home_t, keepassxc_home_t)
	allow $1 keepassxc_home_t:file map;
	allow $1 keepassxc_home_t:dir watch;
')

########################################
## <summary>
##	Allow KeepassXC to connect to a desktop-owned stream socket
##	(e.g. the Wayland session socket owned by staff_t).
## </summary>
## <param name="peer_domain">
##	<summary>
##	Domain owning the peer socket.
##	</summary>
## </param>
#
interface(`local_keepassxc_stream_connect',`
	gen_require(`
		type keepassxc_t;
	')

	allow keepassxc_t $1:unix_stream_socket connectto;
')

########################################
## <summary>
##	Allow KeepassXC to connect to a role's session Wayland compositor
##	socket.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the session's Wayland socket.
##	</summary>
## </param>
#
interface(`local_keepassxc_wayland_connect',`
	gen_require(`
		type keepassxc_t;
	')

	local_$1_wayland_connect(keepassxc_t)
')

########################################
## <summary>
##	Allow a domain to read KeepassXC's process state (/proc/pid), e.g.
##	Xwayland reading the cmdline of a connecting X11 client for
##	_NET_WM_PID-style client identification.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`local_keepassxc_read_proc_state',`
	gen_require(`
		type keepassxc_t;
	')

	allow $1 keepassxc_t:dir list_dir_perms;
	read_files_pattern($1, keepassxc_t, keepassxc_t)
	read_lnk_files_pattern($1, keepassxc_t, keepassxc_t)
')

########################################
## <summary>
##	Allow KeepassXC to exchange D-Bus messages with a desktop-owned domain
##	(e.g. xdg-desktop-portal's Settings interface for theme detection).
## </summary>
## <param name="peer_domain">
##	<summary>
##	Domain to exchange messages with.
##	</summary>
## </param>
#
interface(`local_keepassxc_dbus_chat',`
	gen_require(`
		type keepassxc_t;
		class dbus send_msg;
	')

	allow keepassxc_t $1:dbus send_msg;
	allow $1 keepassxc_t:dbus send_msg;
')
