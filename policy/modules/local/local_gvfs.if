## <summary>
##	Local GVFS domains and helper interfaces.
## </summary>

########################################
## <summary>
##	Role access for GVFS user daemons.
## </summary>
## <param name="role_prefix">
##	<summary>
##	The prefix of the user role, for example staff or user.
##	</summary>
## </param>
## <param name="user_domain">
##	<summary>
##	User domain for the role.
##	</summary>
## </param>
## <param name="user_exec_domain">
##	<summary>
##	User exec domain for execute and transition access.
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access.
##	</summary>
## </param>
#
template(`gvfs_role',`
	gen_require(`
		role $4;
		attribute $3;
		type gvfsd_exec_t, gvfsd_fuse_exec_t, gvfsd_runtime_t, fusefs_t;
		type gvfs_volume_monitor_exec_t, mount_runtime_t;
		type mount_t, sysctl_vm_t, sysctl_vm_overcommit_t;
		type $1_systemd_t, $1_dbusd_t;
		type session_dbusd_runtime_t;
		type bin_t, proc_t;
	')

	type $1_gvfsd_t;
	type $1_gvfsd_fuse_t;
	type $1_gvfs_volume_monitor_t;
	userdom_user_application_domain($1_gvfsd_t, gvfsd_exec_t)
	userdom_user_application_domain($1_gvfsd_fuse_t, gvfsd_fuse_exec_t)
	userdom_user_application_domain($1_gvfs_volume_monitor_t, gvfs_volume_monitor_exec_t)
	role $4 types { $1_gvfsd_t $1_gvfsd_fuse_t $1_gvfs_volume_monitor_t };

	domtrans_pattern($3, gvfsd_exec_t, $1_gvfsd_t)
	domtrans_pattern($3, gvfsd_fuse_exec_t, $1_gvfsd_fuse_t)
	domtrans_pattern($1_gvfsd_t, gvfsd_fuse_exec_t, $1_gvfsd_fuse_t)

	allow $3 { $1_gvfsd_t $1_gvfsd_fuse_t }:process { ptrace signal_perms };
	allow $3 { $1_gvfsd_t $1_gvfsd_fuse_t }:fd use;
	ps_process_pattern($3, $1_gvfsd_t)
	ps_process_pattern($3, $1_gvfsd_fuse_t)
	ps_process_pattern($1_systemd_t, mount_t)

	allow $1_gvfsd_t $3:process sigchld;
	allow $1_gvfsd_fuse_t { $3 $1_gvfsd_t }:process sigchld;
	allow $1_gvfsd_fuse_t self:process signal;
	allow $1_gvfsd_t $1_gvfsd_fuse_t:process { noatsecure rlimitinh siginh };
	allow $1_systemd_t mount_t:process signal;

	auth_use_nsswitch($1_gvfsd_t)
	auth_use_nsswitch($1_gvfsd_fuse_t)
	dbus_all_session_bus_client($1_gvfsd_t)
	dbus_write_session_runtime_socket($1_gvfsd_t)
	dbus_all_session_bus_client($1_gvfsd_fuse_t)
	dbus_write_session_runtime_socket($1_gvfsd_fuse_t)
	allow $3 $1_gvfsd_t:dbus send_msg;
	allow $1_gvfsd_t $3:dbus send_msg;
	allow $1_gvfsd_fuse_t $1_gvfsd_t:dbus send_msg;
	allow $1_gvfsd_t $1_gvfsd_fuse_t:dbus send_msg;
	allow $1_gvfsd_t $1_dbusd_t:dbus acquire_svc;
	allow $1_gvfsd_t session_dbusd_runtime_t:sock_file getattr;
	files_read_usr_files($1_gvfsd_t)
	files_map_usr_files($1_gvfsd_t)
	files_read_usr_files($1_gvfsd_fuse_t)
	files_map_usr_files($1_gvfsd_fuse_t)
	allow { $1_gvfsd_t $1_gvfsd_fuse_t } proc_t:file { getattr open read };
	allow $1_gvfsd_t bin_t:dir search;
	miscfiles_read_localization($1_gvfsd_t)
	miscfiles_read_localization($1_gvfsd_fuse_t)
	xdg_search_config_dirs($1_gvfsd_t)
	xdg_search_data_dirs($1_gvfsd_t)
	xdg_search_config_dirs($1_gvfsd_fuse_t)
	xdg_search_data_dirs($1_gvfsd_fuse_t)
	userdom_search_user_runtime($1_gvfsd_t)
	userdom_search_user_runtime($1_gvfsd_fuse_t)
	allow $1_gvfsd_fuse_t sysctl_vm_t:dir search;
	allow $1_gvfsd_fuse_t sysctl_vm_overcommit_t:file { open read };

	allow $1_gvfsd_t self:fifo_file { getattr read write };

	# UDisks2-backed volume monitor: separate from gvfsd because it needs
	# udisks (system bus), udev and uevent access that the file-backend
	# daemon does not.
	domtrans_pattern($3, gvfs_volume_monitor_exec_t, $1_gvfs_volume_monitor_t)
	allow $3 $1_gvfs_volume_monitor_t:process { ptrace signal_perms };
	allow $3 $1_gvfs_volume_monitor_t:fd use;
	ps_process_pattern($3, $1_gvfs_volume_monitor_t)
	allow $1_gvfs_volume_monitor_t $3:process sigchld;

	auth_use_nsswitch($1_gvfs_volume_monitor_t)
	dbus_all_session_bus_client($1_gvfs_volume_monitor_t)
	dbus_write_session_runtime_socket($1_gvfs_volume_monitor_t)
	dbus_system_bus_client($1_gvfs_volume_monitor_t)
	devicekit_dbus_chat_disk($1_gvfs_volume_monitor_t)
	allow $3 $1_gvfs_volume_monitor_t:dbus send_msg;
	allow $1_gvfs_volume_monitor_t $3:dbus send_msg;
	allow $1_gvfs_volume_monitor_t $1_dbusd_t:dbus acquire_svc;
	allow $1_gvfs_volume_monitor_t session_dbusd_runtime_t:sock_file getattr;
	allow $1_gvfsd_t $1_gvfs_volume_monitor_t:dbus send_msg;
	allow $1_gvfs_volume_monitor_t $1_gvfsd_t:dbus send_msg;

	files_read_usr_files($1_gvfs_volume_monitor_t)
	files_map_usr_files($1_gvfs_volume_monitor_t)
	miscfiles_read_localization($1_gvfs_volume_monitor_t)
	xdg_search_config_dirs($1_gvfs_volume_monitor_t)
	xdg_search_data_dirs($1_gvfs_volume_monitor_t)
	userdom_search_user_runtime($1_gvfs_volume_monitor_t)
	kernel_read_system_state($1_gvfs_volume_monitor_t)
	dev_read_sysfs($1_gvfs_volume_monitor_t)
	fs_getattr_all_fs($1_gvfs_volume_monitor_t)
	udev_read_runtime_files($1_gvfs_volume_monitor_t)
	allow $1_gvfs_volume_monitor_t proc_t:file { getattr open read };

	# libmount watches the mount table; gudev listens for kernel uevents.
	mount_list_runtime($1_gvfs_volume_monitor_t)
	mount_read_runtime_files($1_gvfs_volume_monitor_t)
	allow $1_gvfs_volume_monitor_t mount_runtime_t:dir watch;
	allow $1_gvfs_volume_monitor_t self:netlink_kobject_uevent_socket { create_socket_perms read };
	allow $1_gvfs_volume_monitor_t self:fifo_file { getattr read write };
	allow $1_gvfs_volume_monitor_t self:unix_dgram_socket create_socket_perms;
	allow $1_gvfs_volume_monitor_t self:process { getsched signal };
	local_systemd_inherit_user_service($1, $1_gvfs_volume_monitor_t)
	local_systemd_inherit_user_service($1, $1_gvfsd_t)
	local_systemd_inherit_user_service($1, $1_gvfsd_fuse_t)

	manage_dirs_pattern($1_gvfsd_t, gvfsd_runtime_t, gvfsd_runtime_t)
	userdom_user_runtime_filetrans($1_gvfsd_t, gvfsd_runtime_t, dir, "gvfs")
	userdom_user_runtime_filetrans($1_gvfsd_t, gvfsd_runtime_t, dir, "gvfsd")
	manage_dirs_pattern($1_gvfsd_fuse_t, gvfsd_runtime_t, gvfsd_runtime_t)
	allow $1_gvfsd_fuse_t gvfsd_runtime_t:dir mounton;

	storage_rw_fuse($1_gvfsd_fuse_t)
	allow $1_gvfsd_fuse_t fusefs_t:dir getattr;
	mount_run($1_gvfsd_fuse_t, $4)
	allow $1_gvfsd_fuse_t mount_t:process { noatsecure rlimitinh siginh };
	mount_use_fds($1_gvfsd_fuse_t)
	mount_signal($1_gvfsd_fuse_t)
	allow mount_t gvfsd_runtime_t:dir { getattr search write mounton };
	allow mount_t $1_gvfsd_t:fd use;
	allow mount_t $1_gvfsd_t:fifo_file { read write };
	allow mount_t $1_gvfsd_fuse_t:unix_stream_socket { getattr read write };
	allow mount_t $1_systemd_t:fd use;
	allow mount_t $1_systemd_t:unix_stream_socket { read write };
')

########################################
## <summary>
##	Allow a domain to chat with the role GVFS daemon and volume monitor over D-Bus.
## </summary>
## <param name="role_prefix">
##	<summary>
##	The prefix of the user role owning the GVFS daemon, for example staff.
##	</summary>
## </param>
## <param name="domain">
##	<summary>
##	Domain allowed to exchange D-Bus messages with the GVFS daemon.
##	</summary>
## </param>
#
interface(`local_gvfs_dbus_chat',`
	gen_require(`
		type $1_gvfsd_t, $1_gvfs_volume_monitor_t;
		class dbus send_msg;
	')

	allow $2 $1_gvfsd_t:dbus send_msg;
	allow $1_gvfsd_t $2:dbus send_msg;
	# GIO clients also query the volume monitor over the session bus.
	allow $2 $1_gvfs_volume_monitor_t:dbus send_msg;
	allow $1_gvfs_volume_monitor_t $2:dbus send_msg;
')
