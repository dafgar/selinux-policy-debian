## <summary>
##	Local Plasma session services domain (kded6, kactivitymanagerd).
## </summary>

########################################
## <summary>
##	Allow a role to transition into the Plasma session services domain.
## </summary>
## <param name="source_domain">
##	<summary>
##	Domain allowed to execute and transition to the services.
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access to the services domain.
##	</summary>
## </param>
#
interface(`plasma_services_role',`
	gen_require(`
		type plasma_services_t, kded_exec_t, kactivitymanagerd_exec_t;
		role $2;
	')

	role $2 types plasma_services_t;
	domtrans_pattern($1, kded_exec_t, plasma_services_t)
	domtrans_pattern($1, kactivitymanagerd_exec_t, plasma_services_t)

	allow $1 plasma_services_t:fd use;
	allow $1 plasma_services_t:process { ptrace signal_perms };
	ps_process_pattern($1, plasma_services_t)

	allow plasma_services_t $1:process sigchld;
')

########################################
## <summary>
##	Wire up all of a role access to/from the Plasma session services:
##	D-Bus chat with the role main domain and systemd inherited-exec launch.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the session resources.
##	</summary>
## </param>
#
interface(`local_plasma_services_role',`
	local_kde_session_bus_owner($1, plasma_services_t)
	local_plasma_services_dbus_chat($1_t)
	# The user systemd manager emits PropertiesChanged signals kded6 listens to.
	local_plasma_services_dbus_chat($1_systemd_t)
	local_plasma_services_systemd_inherit($1)
')

########################################
## <summary>
##	Send and receive D-Bus messages with the Plasma session services.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed to exchange D-Bus messages.
##	</summary>
## </param>
#
interface(`local_plasma_services_dbus_chat',`
	gen_require(`
		type plasma_services_t;
		class dbus send_msg;
	')

	allow $1 plasma_services_t:dbus send_msg;
	allow plasma_services_t $1:dbus send_msg;
')

########################################
## <summary>
##	Allow a user systemd instance to launch the Plasma session services
##	with the usual inherited-exec process bits.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the user systemd domain.
##	</summary>
## </param>
#
interface(`local_plasma_services_systemd_inherit',`
	gen_require(`
		type plasma_services_t;
	')

	local_systemd_inherit_user_service($1, plasma_services_t)
	allow plasma_services_t $1_systemd_t:unix_stream_socket { getattr ioctl };
')
