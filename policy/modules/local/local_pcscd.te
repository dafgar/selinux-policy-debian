policy_module(local_pcscd)

gen_require(`
	type mozilla_t;
	type pcscd_t;
	type thunderbird_t;
')

# pcscd performs low-risk filesystem metadata probes on sysfs while discovering
# smartcard-related devices. Keep this limited to filesystem getattr.
dev_getattr_sysfs(pcscd_t)

# pcscd reads udev metadata for smartcard-related USB devices under /run/udev.
udev_read_runtime_files(pcscd_t)

# pcscd inspects Thunderbird client processes while servicing smartcard access.
ps_process_pattern(pcscd_t, thunderbird_t)

# Firefox/Mozilla clients use the same PC/SC path and trigger the same minimal
# peer /proc inspection by pcscd.
ps_process_pattern(pcscd_t, mozilla_t)
