policy_module(local_keepassxc)

attribute_role keepassxc_roles;

type keepassxc_t;
type keepassxc_exec_t;
userdom_user_application_domain(keepassxc_t, keepassxc_exec_t)
role keepassxc_roles types keepassxc_t;

type keepassxc_home_t;
userdom_user_home_content(keepassxc_home_t)

manage_dirs_pattern(keepassxc_t, keepassxc_home_t, keepassxc_home_t)
mmap_manage_files_pattern(keepassxc_t, keepassxc_home_t, keepassxc_home_t)
manage_lnk_files_pattern(keepassxc_t, keepassxc_home_t, keepassxc_home_t)
userdom_user_home_dir_filetrans_user_home_content(keepassxc_t, { dir file lnk_file }, ".keepass2")

# Key files are a static secret backed up once outside the vault dir, unlike
# the .kdbx database which changes often and stays encrypted at rest. Keep
# them off local_keepassxc_read_home_content so staff_t (or anything else
# with generic vault-dir read access) can't read them back out.
type keepassxc_key_t;
userdom_user_home_content(keepassxc_key_t)

mmap_manage_files_pattern(keepassxc_t, keepassxc_home_t, keepassxc_key_t)
manage_lnk_files_pattern(keepassxc_t, keepassxc_home_t, keepassxc_key_t)

# Auto-reload-on-external-change watches the vault file itself.
allow keepassxc_t keepassxc_home_t:file watch;

type keepassxc_xdg_cache_t;
xdg_cache_content(keepassxc_xdg_cache_t)

manage_dirs_pattern(keepassxc_t, keepassxc_xdg_cache_t, keepassxc_xdg_cache_t)
manage_files_pattern(keepassxc_t, keepassxc_xdg_cache_t, keepassxc_xdg_cache_t)
manage_lnk_files_pattern(keepassxc_t, keepassxc_xdg_cache_t, keepassxc_xdg_cache_t)
xdg_cache_filetrans(keepassxc_t, keepassxc_xdg_cache_t, dir, "keepassxc")

gen_require(`
	type tmp_t;
	type urandom_device_t;
')

auth_use_nsswitch(keepassxc_t)
dbus_all_session_bus_client(keepassxc_t)
dbus_connect_system_bus(keepassxc_t)
dbus_system_bus_client(keepassxc_t)
dbus_write_session_runtime_socket(keepassxc_t)
systemd_dbus_chat_logind(keepassxc_t)
files_read_usr_files(keepassxc_t)
files_map_usr_files(keepassxc_t)
miscfiles_read_localization(keepassxc_t)
miscfiles_read_fonts(keepassxc_t)
xdg_search_config_dirs(keepassxc_t)
xdg_read_config_files(keepassxc_t)
xdg_search_data_dirs(keepassxc_t)
userdom_search_user_runtime(keepassxc_t)
userdom_search_user_home_dirs(keepassxc_t)
corecmd_search_bin(keepassxc_t)
kernel_read_kernel_sysctls(keepassxc_t)
dev_read_urand(keepassxc_t)
dev_rw_dri(keepassxc_t)
xserver_read_xkb_libs(keepassxc_t)
xserver_rw_mesa_shader_cache(keepassxc_t)
wm_map_tmpfs_files(keepassxc_t)
wm_rw_tmpfs_files(keepassxc_t)
pcscd_stream_connect(keepassxc_t)
userdom_write_user_tmp_sockets(keepassxc_t)

allow keepassxc_t self:process { getsched setsched setrlimit };

# Qt SingleApplication guard: a per-user lock file, a local IPC socket, and a
# transient staging dir under /tmp with variable names. Keep the generic
# tmp_t fallback limited to the exact operations observed rather than a
# broad manage_*_pattern across a system-wide shared type.
allow keepassxc_t tmp_t:dir { create read write getattr setattr search add_name remove_name rmdir };
allow keepassxc_t tmp_t:file { create open read write lock };
allow keepassxc_t tmp_t:sock_file { create setattr rename };

dontaudit keepassxc_t urandom_device_t:chr_file write;
