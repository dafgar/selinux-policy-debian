## <summary>
##	Local RSIBreak domain interfaces.
## </summary>

########################################
## <summary>
##	Allow a role to transition into the RSIBreak application domain.
## </summary>
## <param name="source_domain">
##	<summary>
##	Domain allowed to execute and transition to RSIBreak.
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access to the RSIBreak domain.
##	</summary>
## </param>
#
interface(`rsibreak_role',`
	gen_require(`
		type rsibreak_t, rsibreak_exec_t;
		role $2;
	')

	role $2 types rsibreak_t;
	domtrans_pattern($1, rsibreak_exec_t, rsibreak_t)

	allow $1 rsibreak_t:process { ptrace signal_perms };
	allow $1 rsibreak_t:fd use;
	ps_process_pattern($1, rsibreak_t)

	allow rsibreak_t $1:process sigchld;
')

########################################
## <summary>
##	Wire up all of a role access to/from RSIBreak beyond the base role
##	template: D-Bus chat, bus name publish, X11 connect, Wayland
##	compositor connect, and the role Xwayland domain reading process
##	state.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the D-Bus/X11/Wayland/Xwayland session
##	resources.
##	</summary>
## </param>
#
interface(`local_rsibreak_role',`
	local_rsibreak_dbus_chat($1_t)
	local_rsibreak_publish_bus_name($1)
	local_rsibreak_x11_connect($1_t)
	local_rsibreak_wayland_connect($1)
	local_rsibreak_read_proc_state($1_xwayland_t)
')

########################################
## <summary>
##	Allow bidirectional D-Bus method call/reply between a domain and
##	RSIBreak.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed to exchange D-Bus messages with RSIBreak.
##	</summary>
## </param>
#
interface(`local_rsibreak_dbus_chat',`
	gen_require(`
		type rsibreak_t;
	')

	allow $1 rsibreak_t:dbus send_msg;
	allow rsibreak_t $1:dbus send_msg;
')

########################################
## <summary>
##	Allow RSIBreak to publish its D-Bus service (org.kde.rsibreak) on the
##	per-role session bus.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the session D-Bus domain.
##	</summary>
## </param>
#
interface(`local_rsibreak_publish_bus_name',`
	gen_require(`
		type rsibreak_t;
		type $1_dbusd_t;
		class dbus acquire_svc;
	')

	allow rsibreak_t $1_dbusd_t:dbus acquire_svc;
')

########################################
## <summary>
##	Allow RSIBreak to connect directly to an X11 socket owned by another
##	domain (e.g. staff_t, the compositor/Xwayland on this desktop).
## </summary>
## <param name="domain">
##	<summary>
##	Domain owning the X11 socket.
##	</summary>
## </param>
#
interface(`local_rsibreak_x11_connect',`
	gen_require(`
		type rsibreak_t;
	')

	allow rsibreak_t $1:unix_stream_socket connectto;
')

########################################
## <summary>
##	Allow RSIBreak to connect to a role's session Wayland compositor
##	socket.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the session's Wayland socket.
##	</summary>
## </param>
#
interface(`local_rsibreak_wayland_connect',`
	gen_require(`
		type rsibreak_t;
	')

	local_$1_wayland_connect(rsibreak_t)
')

########################################
## <summary>
##	Allow a domain to read RSIBreak's process state (/proc/pid), e.g.
##	Xwayland reading the cmdline of a connecting X11 client for
##	_NET_WM_PID-style client identification.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`local_rsibreak_read_proc_state',`
	gen_require(`
		type rsibreak_t;
	')

	allow $1 rsibreak_t:dir list_dir_perms;
	read_files_pattern($1, rsibreak_t, rsibreak_t)
	read_lnk_files_pattern($1, rsibreak_t, rsibreak_t)
')

########################################
## <summary>
## Allow a user systemd instance to launch RSIBreak with the usual
## inherited-exec process bits.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the user systemd domain.
##	</summary>
## </param>
#
interface(`local_rsibreak_systemd_inherit',`
	gen_require(`
		type rsibreak_t;
	')

	local_systemd_inherit_user_service($1, rsibreak_t)
')
