policy_module(local_svirt)

gen_require(`
	type svirt_t;
	type virt_image_t;
')

# QEMU needs normal managed access to guest image files under virt_image_t.
virt_manage_images(svirt_t)

# The image open path also issues file ioctls on qcow2 storage.
allow svirt_t virt_image_t:file ioctl;

# QEMU probes host CPU topology and VM-related sysctls during startup.
dev_read_sysfs(svirt_t)
kernel_read_vm_sysctls(svirt_t)

# QEMU uses io_uring for asynchronous I/O on guest storage.
allow svirt_t self:anon_inode { create map read write };
