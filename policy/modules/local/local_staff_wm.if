## <summary>
## Local staff window-manager policy adjustments.
## </summary>

########################################
## <summary>
##	Allow a domain to send and receive D-Bus messages with the role
##	window manager (kwin_wayland), e.g. registering global shortcuts
##	through org.kde.KGlobalAccel.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the window manager domain.
##	</summary>
## </param>
## <param name="domain">
##	<summary>
##	Domain allowed to exchange D-Bus messages.
##	</summary>
## </param>
#
interface(`local_wm_dbus_chat',`
	gen_require(`
		type $1_wm_t;
		class dbus send_msg;
	')

	allow $2 $1_wm_t:dbus send_msg;
	allow $1_wm_t $2:dbus send_msg;
')
