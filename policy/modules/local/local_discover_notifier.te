policy_module(local_discover_notifier)

attribute_role discover_notifier_roles;

type discover_notifier_t;
type discover_notifier_exec_t;
userdom_user_application_domain(discover_notifier_t, discover_notifier_exec_t)
role discover_notifier_roles types discover_notifier_t;

auth_use_nsswitch(discover_notifier_t)
dbus_all_session_bus_client(discover_notifier_t)
dbus_write_session_runtime_socket(discover_notifier_t)
networkmanager_dbus_chat(discover_notifier_t)
systemd_dbus_chat_logind(discover_notifier_t)
files_read_usr_files(discover_notifier_t)
files_map_usr_files(discover_notifier_t)
miscfiles_read_localization(discover_notifier_t)
miscfiles_read_fonts(discover_notifier_t)
xserver_use_user_fonts(discover_notifier_t)
userdom_search_user_runtime(discover_notifier_t)

# glib g_get_boot_id() / machine-id fallback
kernel_read_kernel_sysctls(discover_notifier_t)

# reads ~/.config/kdeglobals, ~/.config/kdedefaults/kdeglobals for Qt/KDE
# theming.
local_kde_read_config_files(discover_notifier_t)

# Discover's Flatpak update check: reads the user + system ostree repo
# metadata (~/.local/share/flatpak/repo, /var/lib/flatpak/repo/config) and
# the local flatpak summary cache (~/.cache/flatpak/system-cache). The write
# on xdg_data_t:dir is libostree taking a lock under repo/objects while
# refreshing the summary. All generic types shared with unrelated xdg
# data/cache readers; consider a dedicated flatpak_repo_t if this grows.
xdg_read_data_files(discover_notifier_t)

gen_require(`
	type xdg_data_t;
')
allow discover_notifier_t xdg_data_t:dir write;
xdg_read_cache_files(discover_notifier_t)
files_read_var_lib_files(discover_notifier_t)
fs_getattr_all_fs(discover_notifier_t)

# glib thread pool sched_getparam() on its own threads
dontaudit discover_notifier_t self:process getsched;
# Internal thread signaling.
allow discover_notifier_t self:process signal;
