policy_module(local_chromium)

gen_require(`
	type alsa_var_lib_t;
	type chromium_t;
	type chromium_xdg_config_t;
	type debugfs_t;
	type devlog_t;
	type gnome_xdg_config_t;
	type locale_t;
	type mozilla_exec_t;
	type pcscd_runtime_t;
	type pcscd_t;
	type pulseaudio_tmp_t;
	type pulseaudio_xdg_config_t;
	type pipewire_runtime_t;
	type proc_t;
	type security_t;
	type selinux_config_t;
	type bluetooth_t;
	type syslogd_t;
	type syslogd_runtime_t;
	type sysfs_t;
	type user_tmp_t;
	type v4l_device_t;
	type xkb_var_lib_t;
	type xdg_cache_t;
	class dbus send_msg;
')

# Wayland display sockets like wayland-0 are currently labeled user_tmp_t on
# this system. Chromium needs write access to connect to the compositor socket.
local_userdomain_dontaudit_generic_home_when_disabled(`chromium_read_generic_user_content', chromium_t)
allow chromium_t user_tmp_t:sock_file write;
allow chromium_t pipewire_runtime_t:sock_file write;

# Chromium probes SELinux, procfs, sysfs, and XKB data during startup and
# feature detection.
allow chromium_t security_t:filesystem getattr;
allow chromium_t selinux_config_t:dir search;
allow chromium_t proc_t:file read;
allow chromium_t sysfs_t:file read;
allow chromium_t sysfs_t:lnk_file read;
allow chromium_t xkb_var_lib_t:dir { getattr read search };
allow chromium_t xkb_var_lib_t:file { getattr map open read };

# Chromium reads desktop configuration through dconf and updates GPU shader
# cache state under the generic XDG cache label.
allow chromium_t gnome_xdg_config_t:dir { read search };
allow chromium_t gnome_xdg_config_t:file { getattr map open read };
allow chromium_t xdg_cache_t:file { getattr open read write };
allow chromium_t syslogd_runtime_t:dir search;
allow chromium_t devlog_t:sock_file write;
allow chromium_t syslogd_t:unix_dgram_socket sendto;
allow chromium_t pcscd_runtime_t:dir search;
allow chromium_t pcscd_runtime_t:sock_file { getattr write };
allow chromium_t pcscd_t:unix_stream_socket connectto;
allow chromium_t locale_t:dir watch;
allow chromium_t debugfs_t:dir search;

# Chromium's audio and camera helper services enumerate ALSA state and V4L
# devices during startup.
allow chromium_t alsa_var_lib_t:dir search;
allow chromium_t pulseaudio_tmp_t:dir read;
allow chromium_t pulseaudio_xdg_config_t:dir search;
allow chromium_t pulseaudio_xdg_config_t:file { lock open read };
allow chromium_t v4l_device_t:chr_file { getattr ioctl map open read write };

# Optional browser/DRM integration probes are not needed for the current
# Chromium setup.
dontaudit chromium_t mozilla_exec_t:file getattr;
dontaudit chromium_t chromium_xdg_config_t:file execute;
dontaudit chromium_t user_tmp_t:file write;
dontaudit chromium_t bluetooth_t:dbus send_msg;
