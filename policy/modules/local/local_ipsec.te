policy_module(local_ipsec)

gen_require(`
	type ipsec_t;
')

# strongSwan mutates TPM2 PKCS#11 state under /etc/tpm2_pkcs11 on this system.
# Keep the path typing in local_tpm2_pkcs11 and grant ipsec_t access via that
# module's interface so other consumers can be added without coupling them here.
local_tpm2_pkcs11_manage_etc(ipsec_t)

# charon-systemd uses AF_ALG, packet, and raw IP sockets directly. The base
# ipsec policy already covers its UDP/TCP/netlink/key sockets; extend only the
# missing self permissions seen in the AVCs here.
allow ipsec_t self:capability net_raw;
allow ipsec_t self:alg_socket { create bind };
allow ipsec_t self:packet_socket { create ioctl read setopt };
allow ipsec_t self:rawip_socket { create ioctl setopt };
