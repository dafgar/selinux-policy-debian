policy_module(local_staff_systemd)

gen_require(`
	type staff_systemd_t;
	type unlabeled_t;
')

# The user systemd instance creates the per-session GnuPG runtime directory
# and populates it with entries such as S.dirmngr before the GnuPG helper
# domains take over. Keep this limited to the observed directory operations.
local_gpg_manage_runtime_dirs(staff_systemd_t)

# The user systemd instance also prepares the keyring control socket before
# handing off to the keyring daemon domain.
local_gnome_systemd_keyring_socket(staff)

# utempter can inherit a stream socket fd from the user systemd instance.
local_utempter_systemd_socket_inherit(staff_systemd_t)

# Zotero inherits a stream socket fd from the user systemd instance during
# startup and uses metadata/ioctl on that same parent-owned socket.
local_zotero_systemd_socket_inherit(staff_systemd_t)

# systemd --user performs generic filesystem probing on inherited fds during
# session startup. Keep pidfs filesystem getattr noise hidden until there is a
# concrete need to model it more specifically.
dontaudit staff_systemd_t unlabeled_t:filesystem getattr;
