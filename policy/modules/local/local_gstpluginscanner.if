## <summary>
##	Local GStreamer plugin scanner domain interfaces.
## </summary>

########################################
## <summary>
##	Allow a role to transition into the GStreamer plugin scanner domain.
## </summary>
## <param name="source_domain">
##	<summary>
##	Domain allowed to execute and transition to the GStreamer plugin
##	scanner domain.
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access to the GStreamer plugin scanner domain.
##	</summary>
## </param>
#
interface(`gstpluginscanner_role',`
	gen_require(`
		type gstpluginscanner_t, gstpluginscanner_exec_t;
		role $2;
	')

	role $2 types gstpluginscanner_t;
	domtrans_pattern($1, gstpluginscanner_exec_t, gstpluginscanner_t)

	allow $1 gstpluginscanner_t:process { ptrace signal_perms };
	allow $1 gstpluginscanner_t:fd use;
	ps_process_pattern($1, gstpluginscanner_t)

	allow gstpluginscanner_t $1:process sigchld;
')
