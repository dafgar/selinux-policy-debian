## <summary>
##	Local Zotero domain interfaces.
## </summary>

########################################
## <summary>
##	Allow a role to transition into the Zotero application domain.
## </summary>
## <param name="source_domain">
##	<summary>
##	Domain allowed to execute and transition to Zotero.
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access to the Zotero domain.
##	</summary>
## </param>
#
interface(`zotero_role',`
	gen_require(`
		type zotero_t, zotero_exec_t;
		role $2;
	')

	role $2 types zotero_t;
	domtrans_pattern($1, zotero_exec_t, zotero_t)

	allow $1 zotero_t:fd use;
	allow $1 zotero_t:process { ptrace signal_perms };
	ps_process_pattern($1, zotero_t)

	allow zotero_t $1:process sigchld;
')

########################################
## <summary>
##	Allow Zotero to use an inherited user-systemd stream socket.
## </summary>
## <param name="systemd_domain">
##	<summary>
##	User systemd domain owning the inherited socket and fd.
##	</summary>
## </param>
#
interface(`local_zotero_systemd_socket_inherit',`
	gen_require(`
		type zotero_t;
	')

	allow zotero_t $1:fd use;
	allow zotero_t $1:unix_stream_socket { getattr ioctl read write };
')

########################################
## <summary>
##	Wire up all of a role access to/from Zotero beyond the base role
##	template: D-Bus chat, stream connect, home content read, and bus
##	name publish.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the Wayland/Xwayland/D-Bus session
##	resources.
##	</summary>
## </param>
#
interface(`local_zotero_role',`
	local_zotero_dbus_chat($1_t)
	# Uncertain whether the Zotero Gecko renderer runs X11-via-Xwayland or
	# native Wayland - no dedicated tmpfs type consumed by $1_wm_t (unlike
	# evince/evolution_alarm/chromium) and no MIT-SHM grant either way to
	# tell. Granting both peers for now; narrow down to one from a fresh
	# AVC log once it is actually exercised (see project_xwayland_split_todo
	# memory).
	local_zotero_stream_connect($1_t)
	local_zotero_stream_connect($1_wm_t)
	local_zotero_read_home_content($1_t)
	local_zotero_publish_bus_name($1)
')

########################################
## <summary>
##	Allow Zotero to connect to a desktop-owned stream socket.
## </summary>
## <param name="peer_domain">
##	<summary>
##	Domain owning the peer socket.
##	</summary>
## </param>
#
interface(`local_zotero_stream_connect',`
	gen_require(`
		type zotero_t;
	')

	allow zotero_t $1:unix_stream_socket connectto;
')

########################################
## <summary>
##	Allow Zotero to chat with a desktop-owned D-Bus service.
## </summary>
## <param name="peer_domain">
##	<summary>
##	Domain owning the D-Bus service.
##	</summary>
## </param>
#
interface(`local_zotero_dbus_chat',`
	gen_require(`
		type zotero_t;
		class dbus send_msg;
	')

	allow zotero_t $1:dbus send_msg;
	allow $1 zotero_t:dbus send_msg;
')

########################################
## <summary>
##	Allow Zotero to publish its single-instance remote-control D-Bus
##	service (org.mozilla.zotero.*) on the per-role session bus.
## </summary>
## <param name="role_prefix">
##	<summary>
##	User role prefix that owns the session D-Bus domain.
##	</summary>
## </param>
#
interface(`local_zotero_publish_bus_name',`
	gen_require(`
		type zotero_t;
		type $1_dbusd_t;
		class dbus acquire_svc;
	')

	allow zotero_t $1_dbusd_t:dbus acquire_svc;
')

########################################
## <summary>
##	Allow a domain to read documents stored under Zotero's home content
##	(e.g. a viewer opening a PDF from Zotero's attachment storage).
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed read access.
##	</summary>
## </param>
#
interface(`local_zotero_read_home_content',`
	gen_require(`
		type zotero_home_t;
	')

	list_dirs_pattern($1, zotero_home_t, zotero_home_t)
	read_files_pattern($1, zotero_home_t, zotero_home_t)
	read_lnk_files_pattern($1, zotero_home_t, zotero_home_t)
	allow $1 zotero_home_t:file map;
	allow $1 zotero_home_t:dir watch;
')
