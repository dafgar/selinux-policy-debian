policy_module(local_powerdevil)

attribute_role powerdevil_roles;

type powerdevil_t;
type powerdevil_exec_t;
userdom_user_application_domain(powerdevil_t, powerdevil_exec_t)
role powerdevil_roles types powerdevil_t;

gen_require(`
	type user_tmp_t;
	type user_home_t;
')

# internal Qt/glib thread wakeup pipe
allow powerdevil_t self:fifo_file { read write };
# AC/lid/battery hotplug fallback via kernel uevents
allow powerdevil_t self:netlink_kobject_uevent_socket read;
# Qt render-thread priority tuning and internal thread signaling, same pair
# other Qt/KDE domains in this repo allow for themselves.
allow powerdevil_t self:process { getsched signal };

auth_use_nsswitch(powerdevil_t)
dbus_all_session_bus_client(powerdevil_t)
dbus_write_session_runtime_socket(powerdevil_t)
devicekit_dbus_chat_disk(powerdevil_t)
devicekit_dbus_chat_power(powerdevil_t)
policykit_dbus_chat(powerdevil_t)
local_powerprofiles_dbus_chat(powerdevil_t)
systemd_dbus_chat_logind(powerdevil_t)
systemd_use_logind_fds(powerdevil_t)
files_read_usr_files(powerdevil_t)
files_map_usr_files(powerdevil_t)
miscfiles_read_localization(powerdevil_t)
miscfiles_read_fonts(powerdevil_t)
xserver_use_user_fonts(powerdevil_t)
xdg_search_config_dirs(powerdevil_t)
xdg_search_data_dirs(powerdevil_t)
userdom_search_user_runtime(powerdevil_t)

# DDC/CI external-monitor brightness control (watch_displays thread) probing
# DRM connectors' i2c buses and the i2c device nodes themselves
dev_read_sysfs(powerdevil_t)
term_getattr_unallocated_ttys(powerdevil_t)
# /proc/filesystems (glib GIO checking available filesystem types).
kernel_read_system_state(powerdevil_t)
# glib g_get_boot_id() / machine-id fallback, same as discover_notifier_t.
kernel_read_kernel_sysctls(powerdevil_t)
# /sbin -> /usr/sbin merged-usr symlink readlink.
corecmd_search_bin(powerdevil_t)
logging_send_syslog_msg(powerdevil_t)
xdg_read_cache_files(powerdevil_t)
local_kde_read_config_files(powerdevil_t)
mount_list_runtime(powerdevil_t)

# Low-disk-space notifier: statfs() on every mounted filesystem.
fs_getattr_all_fs(powerdevil_t)

# Fontconfig probes the legacy ~/.fontconfig path (pre-XDG-spec override
# dir), which is plain user_home_t like any other uncategorized home
# content. Same call local_rsibreak.te/local_konsole.if already make for
# the identical probe: cosmetic-only, harmless to lose.
dontaudit powerdevil_t user_home_t:dir search;

# Per-session MIT-MAGIC-COOKIE xauth file (e.g. xauth_gmOtgU under
# /run/user/<uid>): Qt's XCB backend reads it while probing the X11
# platform. Only read is exercised (open/getattr already satisfied via an
# inherited fd), so keep this to the exact op observed rather than a
# broader grant on the shared user_tmp_t type (same tradeoff as the
# Xwayland xauth getattr in local_xwayland.if).
allow powerdevil_t user_tmp_t:file read;
