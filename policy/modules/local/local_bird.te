policy_module(local_bird)

gen_require(`
	type bird_runtime_t;
	type bird_t;
	type initrc_t;
')

# The base bird policy expects /run/bird and /run/bird.ctl to be bird_runtime_t,
# but in early boot they can be pre-created by initrc_t and fall into the
# generic initrc_runtime_t bucket. Create those runtime objects with the bird
# type up front instead of teaching bird_t to operate on initrc_runtime_t.
files_runtime_filetrans(initrc_t, bird_runtime_t, dir, "bird")
files_runtime_filetrans(initrc_t, bird_runtime_t, sock_file, "bird.ctl")

# BIRD starts as root, prepares its runtime socket state, then drops to the
# bird account while retaining only the capabilities it needs for routing work.
# The dac_override grant follows the observed startup sequence where the daemon
# creates and adjusts control-socket objects before/while changing identity.
# Keep this decision visible and revisit it if BIRD startup is later reworked
# to avoid DAC bypass during the privilege-drop path.
allow bird_t self:capability {
	chown
	dac_override
	dac_read_search
	fowner
	fsetid
	setgid
	setuid
};
allow bird_t self:process setcap;

# BIRD probes socket options on its routing socket during startup.
allow bird_t self:rawip_socket getopt;
